{
  "$schema": "./node_modules/@effect/language-service/schema.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "module": "nodenext",
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@shared/*": [
        "./packages/harness/src/shared/*",
        "./packages/harness/src/shared/*.ts",
        "./packages/harness/src/shared/*/index.ts"
      ],
      "@ui/*": [
        "./packages/texra/src/ui/*",
        "./packages/texra/src/ui/*.ts",
        "./packages/texra/src/ui/*/index.ts"
      ],
      "@texra/*": [
        "./packages/texra/src/*",
        "./packages/texra/src/*.ts",
        "./packages/texra/src/*/index.ts"
      ],
      "@common/webview": ["./packages/extension/src/common/webview/index.ts"],
      "@common/*": [
        "./packages/harness/src/common/*",
        "./packages/harness/src/common/*.ts",
        "./packages/harness/src/common/*/index.ts"
      ],
      "@agent/*": [
        "./packages/harness/src/agent/*",
        "./packages/harness/src/agent/*.ts",
        "./packages/harness/src/agent/*/index.ts"
      ],
      "@frontend/*": [
        "./packages/extension/src/frontend/*",
        "./packages/extension/src/frontend/*.ts",
        "./packages/extension/src/frontend/*/index.ts"
      ],
      "@utils/*": [
        "./packages/harness/src/utils/*",
        "./packages/harness/src/utils/*.ts",
        "./packages/harness/src/utils/*/index.ts"
      ],
      "@logger/*": [
        "./packages/harness/src/logger/*",
        "./packages/harness/src/logger/*.ts",
        "./packages/harness/src/logger/*/index.ts"
      ],
      "@telemetry/*": [
        "./packages/texra/src/telemetry/*",
        "./packages/texra/src/telemetry/*.ts",
        "./packages/texra/src/telemetry/*/index.ts"
      ],
      "@transcript": ["./packages/harness/src/transcript/index.ts"],
      "@transcript/*": [
        "./packages/harness/src/transcript/*",
        "./packages/harness/src/transcript/*.ts",
        "./packages/harness/src/transcript/*/index.ts"
      ],
      "@latex/*": [
        "./packages/texra/src/latex/*",
        "./packages/texra/src/latex/*.ts",
        "./packages/texra/src/latex/*/index.ts"
      ],
      "@commands/*": [
        "./packages/extension/src/commands/*",
        "./packages/extension/src/commands/*.ts",
        "./packages/extension/src/commands/*/index.ts"
      ],
      "@resources/*": [
        "./packages/extension/resources/*",
        "./packages/extension/resources/*.ts",
        "./packages/extension/resources/*/index.ts"
      ],
      "@model/*": [
        "./packages/harness/src/model/*",
        "./packages/harness/src/model/*.ts",
        "./packages/harness/src/model/*/index.ts"
      ],
      "@skills/*": [
        "./packages/harness/src/skills/*",
        "./packages/harness/src/skills/*.ts",
        "./packages/harness/src/skills/*/index.ts"
      ],
      "@housekeeping/*": [
        "./packages/texra/src/housekeeping/*",
        "./packages/texra/src/housekeeping/*.ts",
        "./packages/texra/src/housekeeping/*/index.ts"
      ],
      "@progressView/*": [
        "./packages/extension/src/progressView/*",
        "./packages/extension/src/progressView/*.ts",
        "./packages/extension/src/progressView/*/index.ts"
      ],
      "@settingsView/*": [
        "./packages/extension/src/settingsView/*",
        "./packages/extension/src/settingsView/*.ts",
        "./packages/extension/src/settingsView/*/index.ts"
      ],
      "@replacement/*": [
        "./packages/texra/src/replacement/*",
        "./packages/texra/src/replacement/*.ts",
        "./packages/texra/src/replacement/*/index.ts"
      ],
      "@tools/*": [
        "./packages/harness/src/tools/*",
        "./packages/harness/src/tools/*.ts",
        "./packages/harness/src/tools/*/index.ts"
      ],
      "@eventBus/*": [
        "./packages/harness/src/eventBus/*",
        "./packages/harness/src/eventBus/*.ts",
        "./packages/harness/src/eventBus/*/index.ts"
      ],
      "@platform/*": [
        "./packages/harness/src/platform/*",
        "./packages/harness/src/platform/*.ts",
        "./packages/harness/src/platform/*/index.ts"
      ],
      "@controllers/*": [
        "./packages/harness/src/controllers/*",
        "./packages/harness/src/controllers/*.ts",
        "./packages/harness/src/controllers/*/index.ts"
      ],
      "@test/*": [
        "./src/test-kernel/*",
        "./src/test-kernel/*.ts",
        "./src/test-kernel/*/index.ts"
      ],
      "@cli/*": [
        "./packages/cli/src/*",
        "./packages/cli/src/*.ts",
        "./packages/cli/src/*/index.ts"
      ],
      "@desktop/*": [
        "./packages/desktop/src/*",
        "./packages/desktop/src/*.ts",
        "./packages/desktop/src/*/index.ts"
      ]
    },
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": [
    "packages/harness/src/**/*.ts",
    "packages/harness/src/**/*.tsx",
    "packages/texra/src/**/*.ts",
    "packages/texra/src/**/*.tsx",
    "packages/extension/src/**/*.ts",
    "packages/extension/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "src/test-kernel"]
}
