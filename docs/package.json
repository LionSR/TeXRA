{
  "name": "texra-docs",
  "version": "0.3.0",
  "main": "index.js",
  "scripts": {
    "sync-legal": "cp ../TERMS_OF_SERVICE.md terms.md",
    "sync-changelog": "cp ../CHANGELOG.md changelog.md",
    "sync-content": "npm run sync-legal && npm run sync-changelog",
    "dev": "npm run sync-content && vitepress dev .",
    "docs:build": "npm run sync-content && vitepress build .",
    "docs:serve": "vitepress serve .",
    "docs:deploy": "npm run docs:build && gh-pages --cname texra.ai -d .vitepress/dist -m \"Deploy docs [ci skip]\""
  },
  "keywords": [
    "texra",
    "documentation",
    "academic-writing",
    "vscode-extension",
    "ai"
  ],
  "author": "TeXRA Team",
  "license": "MIT",
  "description": "Documentation for TeXRA - AI-powered academic research assistant",
  "devDependencies": {
    "@awesome.me/webawesome": "^3.6.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "gh-pages": "^6.3.0",
    "mermaid": "^11.6.0",
    "vitepress": "^2.0.0-alpha.15",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "type": "module"
}
