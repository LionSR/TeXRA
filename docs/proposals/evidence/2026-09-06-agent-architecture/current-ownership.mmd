flowchart TB
    host["Host and SDK entry points"]
    runtime["Current agent runtime<br/>ModelFactory · ModelCell · execution lifecycle"]
    flow["PocketFlow-style flows and nodes<br/>ModelInvocationNode · tool-use · reflection"]
    handler["IModelHandler · ModelHandler<br/>Provider I/O + history conversion + workflow policy"]
