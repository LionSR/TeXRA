    tools["ToolUseDispatchNode<br/>Parallel safe groups · mutation barriers"]
    documents["Document and output behavior<br/>Split across handlers and flow nodes"]
    persistence[("PersistedFlow / ExecutionKVStore<br/>Shared state + node cursor; claimed and fenced")]

    host --> runtime --> flow
    flow --> handler --> providers
    flow --> tools
    flow --> documents
    handler --> documents
    flow <-->|persist outer state| persistence

