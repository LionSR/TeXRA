{
  "name": "coauthor",
  "displayName": "CoAuthor",
  "description": "CoAuthor: your never complain nor PUA nor on two-month holidays coauthor.",
  "version": "0.10.3",
  "publisher": "Sirui-Lu",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onView:coauthor",
    "onColorTheme"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "CoAuthor",
        "properties": {
          "coauthor.agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "correct-tex",
              "polish-tex",
              "draw-tex",
              "adapt-tex",
              "write-tex",
              "meeting2text",
              "text2tex",
              "paper2note",
              "paper2cover",
              "paper2slide",
              "paper2poster",
              "slide2paper",
              "write-proposal",
              "txt2tex",
              "translate2chn"
            ],
            "description": "List of available agents",
            "scope": "resource"
          }
        }
      },
      {
        "title": "CoAuthor: File Handling",
        "properties": {
          "coauthor.files.included.inputDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Discrete-Time",
              "PapersEx"
            ],
            "description": "Directories to consider as the root for input files",
            "editPresentation": "multilineText",
            "order": 1
          },
          "coauthor.files.included.figureDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Discrete-Time",
              "FiguresEx",
              "Figures",
              "Figs"
            ],
            "description": "Directories to include in the figure path",
            "editPresentation": "multilineText",
            "order": 2
          },
          "coauthor.files.ignored.figureDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "Versions",
              "versions"
            ],
            "description": "Directories to ignore in the figure path",
            "editPresentation": "multilineText",
            "order": 3
          },
          "coauthor.files.ignored.directories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "figures",
              "figs",
              "versions",
              "Versions",
              "stuff",
              "draft",
              "exercises"
            ],
            "description": "Directories to ignore when listing files",
            "editPresentation": "multilineText",
            "order": 3
          },
          "coauthor.files.ignored.keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Makefile",
              "template",
              "_log",
              "_thinking",
              "_diff",
              "diff",
              "draw",
              "Versions",
              "versions",
              ".egg-info"
            ],
            "description": "Keywords to ignore when selecting files",
            "editPresentation": "multilineText",
            "order": 4
          }
        }
      },
      {
        "title": "CoAuthor: LaTeX",
        "properties": {
          "coauthor.latex.latexindentConfig": {
            "type": "string",
            "default": "/Users/siruilu/Local/TEX/latexindent.yaml",
            "description": "Path to latexindent configuration file",
            "editPresentation": "singlelineText",
            "order": 1
          }
        }
      },
      {
        "title": "CoAuthor: Git",
        "properties": {
          "coauthor.git.numberOfCommitsToShow": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "description": "Number of recent commits to show in the commit selection dropdown",
            "order": 1
          }
        }
      },
      {
        "title": "CoAuthor: Merge",
        "properties": {
          "coauthor.merge.defaultModel": {
            "type": "string",
            "default": "sonnet+",
            "enum": [
              "opus",
              "sonnet+",
              "sonnet",
              "gpt4t",
              "gpt4o",
              "gpt4o-"
            ],
            "enumDescriptions": [
              "Claude 3 Opus",
              "Claude 3 Sonnet+",
              "Claude 3 Sonnet",
              "GPT-4 Turbo",
              "GPT-4O",
              "GPT-4O Mini"
            ],
            "description": "Default model to use for merge operations",
            "order": 1
          },
          "coauthor.merge.defaultReflect": {
            "type": "string",
            "default": "False",
            "enum": [
              "True",
              "False"
            ],
            "description": "Default reflect setting for merge operations",
            "order": 2
          }
        }
      }
    ],
    "commands": [
      {
        "command": "coauthor.cleanOutput",
        "title": "Clean Output"
      },
      {
        "command": "coauthor.cleanBuild",
        "title": "Clean All"
      },
      {
        "command": "coauthor.indentTex",
        "title": "Indent TeX"
      },
      {
        "command": "coauthor.packSingle",
        "title": "Pack Single"
      },
      {
        "command": "coauthor.cleanSingle",
        "title": "Clean Single"
      },
      {
        "command": "coauthor.latexDiff",
        "title": "LaTeX Diff"
      },
      {
        "command": "coauthor.latexDiffVC",
        "title": "LaTeX Diff VC"
      },
      {
        "command": "coauthor.getRecentCommits",
        "title": "Get Recent Commits"
      },
      {
        "command": "coauthor.refreshCommits",
        "title": "Refresh Commits"
      },
      {
        "command": "coauthor.selectMultipleInputFiles",
        "title": "Select Multiple Input Files"
      },
      {
        "command": "coauthor.selectInputFile",
        "title": "Select Input File"
      },
      {
        "command": "coauthor.selectAuxFile",
        "title": "Select Auxiliary File"
      },
      {
        "command": "coauthor.selectFigureFile",
        "title": "Select Figure File"
      },
      {
        "command": "coauthor.execute",
        "title": "Execute Agent"
      },
      {
        "command": "coauthor.merge",
        "title": "CoAuthor: Merge Files"
      },
      {
        "command": "coauthor.openAgentEditor",
        "title": "CoAuthor: Open Agent Editor",
        "category": "CoAuthor"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coauthor",
          "title": "CoAuthor",
          "icon": "resources/scholarly-duck.svg"
        }
      ]
    },
    "views": {
      "coauthor": [
        {
          "type": "webview",
          "id": "coauthor.chatView",
          "name": "Your Favourite CoAuthor ❤️"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "coauthor.agentEditor",
        "displayName": "Agent Editor",
        "selector": [
          {
            "filenamePattern": "*.agent.xml"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "build": "npm run compile && vsce package --out releases/coauthor-$npm_package_version.vsix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.34",
    "@types/vscode": "^1.89.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LionSR/coauthor-for-vs-code.git"
  },
  "license": "MIT",
  "author": "Sirui LU",
  "icon": "resources/scholarly-duck.png",
  "keywords": [
    "latex",
    "academic",
    "writing",
    "coauthor",
    "vscode"
  ],
  "bugs": {
    "url": "https://github.com/LionSR/coauthor-for-vs-code/issues"
  },
  "homepage": "https://github.com/LionSR/coauthor-for-vs-code#readme",
  "dependencies": {
    "jest-worker": "^29.7.0",
    "terser-webpack-plugin": "^5.3.10",
    "xml2js": "^0.6.2"
  }
}
