{
  "name": "coauthor",
  "displayName": "CoAuthor",
  "description": "CoAuthor: your never complain nor PUA nor on two-month holidays coauthor.",
  "version": "0.10.13",
  "publisher": "Sirui-Lu",
  "engines": {
    "vscode": "^1.93.1"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onView:coauthor",
    "onColorTheme"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "CoAuthor",
        "properties": {
          "coauthor.agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "correct-tex",
              "polish-tex",
              "draw-tex",
              "write-tex",
              "meeting2text",
              "text2tex",
              "paper2note",
              "paper2cover",
              "paper2slide",
              "paper2poster",
              "slide2paper",
              "write_proposal",
              "txt2tex",
              "translate2chn",
              "polish_cover"
            ],
            "description": "List of available agents",
            "scope": "resource"
          }
        }
      },
      {
        "title": "CoAuthor: File Handling",
        "properties": {
          "coauthor.files.included.inputDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Discrete-Time",
              "PapersEx"
            ],
            "description": "Directories to consider as the root for input files",
            "editPresentation": "multilineText",
            "order": 1
          },
          "coauthor.files.included.auxDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Discrete-Time",
              "PapersEx"
            ],
            "description": "Directories to consider as the root for auxiliary files",
            "editPresentation": "multilineText",
            "order": 2
          },
          "coauthor.files.included.figureDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Discrete-Time",
              "FiguresEx",
              "Figures",
              "Figs"
            ],
            "description": "Directories to include in the figure path",
            "editPresentation": "multilineText",
            "order": 3
          },
          "coauthor.files.included.figureExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".png",
              ".pdf",
              ".jpeg",
              ".jpg",
              ".svg",
              ".gif",
              ".bmp"
            ],
            "description": "File extensions to include when searching for figures",
            "editPresentation": "multilineText",
            "order": 4
          },
          "coauthor.files.included.inputExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md"
            ],
            "description": "File extensions to include when searching for input files",
            "editPresentation": "multilineText",
            "order": 5
          },
          "coauthor.files.included.referenceExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md"
            ],
            "description": "File extensions to include when searching for reference files",
            "editPresentation": "multilineText",
            "order": 6
          },
          "coauthor.files.included.auxiliaryExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".cls",
              ".md"
            ],
            "description": "File extensions to include when searching for auxiliary files",
            "editPresentation": "multilineText",
            "order": 7
          },
          "coauthor.files.included.editedExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex"
            ],
            "description": "File extensions to include when searching for edited files",
            "editPresentation": "multilineText",
            "order": 8
          },
          "coauthor.files.ignored.fileExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".pdf",
              ".bst",
              ".bib",
              ".cls",
              ".json",
              ".py",
              ".ipynb",
              ".png",
              ".vsix",
              ".ts",
              ".js"
            ],
            "description": "File extensions to ignore when listing text files",
            "editPresentation": "multilineText",
            "order": 9
          },
          "coauthor.files.ignored.inputFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "command.tex",
              "preamble.tex"
            ],
            "description": "Files to ignore when listing input, sample, and edited files, but not auxiliary files",
            "editPresentation": "multilineText",
            "order": 10
          },
          "coauthor.files.ignored.auxiliaryKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "gpt",
              "sonnet",
              "haiku",
              "opus",
              "gemini",
              "llama"
            ],
            "description": "Additional keywords to ignore when listing auxiliary files, including model names",
            "editPresentation": "multilineText",
            "order": 11
          },
          "coauthor.files.ignored.figureDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "versions",
              "history"
            ],
            "description": "Directories to ignore in the figure path",
            "editPresentation": "multilineText",
            "order": 12
          },
          "coauthor.files.ignored.directories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "figures",
              "figs",
              "versions",
              "history",
              "stuff",
              "draft",
              "diff",
              "miscellaneous"
            ],
            "description": "Directories to ignore when listing files",
            "editPresentation": "multilineText",
            "order": 13
          },
          "coauthor.files.ignored.keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Makefile",
              "template",
              "_log",
              "_thinking",
              "_diff",
              "diff",
              "draw",
              "versions",
              "history",
              ".egg-info"
            ],
            "description": "Keywords to ignore when selecting files",
            "editPresentation": "multilineText",
            "order": 14
          }
        }
      },
      {
        "title": "CoAuthor: LaTeX",
        "properties": {
          "coauthor.latex.latexindentConfig": {
            "type": "string",
            "default": "",
            "description": "Path to latexindent configuration file",
            "editPresentation": "singlelineText",
            "order": 1
          }
        }
      },
      {
        "title": "CoAuthor: Python Environment",
        "properties": {
          "coauthor.python.virtualEnvString": {
            "type": "string",
            "default": "",
            "description": "Command to activate Python virtual environment (e.g., 'source venv/bin/activate' for Unix or 'venv\\Scripts\\activate.bat' for Windows). Leave empty to use system Python.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "CoAuthor: Git",
        "properties": {
          "coauthor.git.numberOfCommitsToShow": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "description": "Number of recent commits to show in the commit selection dropdown",
            "order": 1
          }
        }
      },
      {
        "title": "CoAuthor: Merge",
        "properties": {
          "coauthor.merge.defaultModel": {
            "type": "string",
            "default": "sonnet+",
            "enum": [
              "opus",
              "sonnet+",
              "gpt4t",
              "gpt4o",
              "gpt4o-"
            ],
            "enumDescriptions": [
              "Claude 3 Opus",
              "Claude 3 Sonnet+",
              "GPT-4 Turbo",
              "GPT-4O",
              "GPT-4O Mini"
            ],
            "description": "Default model to use for merge operations",
            "order": 1
          },
          "coauthor.merge.defaultReflect": {
            "type": "string",
            "default": "False",
            "enum": [
              "True",
              "False"
            ],
            "description": "Default reflect setting for merge operations",
            "order": 2
          }
        }
      },
      {
        "title": "CoAuthor: File Explorer",
        "properties": {
          "coauthor.explorer.rootPath": {
            "type": "string",
            "default": "",
            "description": "Root path for the CoAuthor file explorer view. Can be absolute or relative to workspace root.",
            "scope": "resource"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "coauthor.cleanOutput",
        "title": "Clean Output"
      },
      {
        "command": "coauthor.cleanBuild",
        "title": "Clean All"
      },
      {
        "command": "coauthor.indentTex",
        "title": "Indent TeX"
      },
      {
        "command": "coauthor.packSingle",
        "title": "Pack Single"
      },
      {
        "command": "coauthor.cleanSingle",
        "title": "Clean Single"
      },
      {
        "command": "coauthor.latexDiff",
        "title": "LaTeX Diff"
      },
      {
        "command": "coauthor.latexDiffVC",
        "title": "LaTeX Diff VC"
      },
      {
        "command": "coauthor.getRecentCommits",
        "title": "Get Recent Commits"
      },
      {
        "command": "coauthor.refreshCommits",
        "title": "Refresh Commits"
      },
      {
        "command": "coauthor.selectMultipleInputFiles",
        "title": "Select Multiple Input Files"
      },
      {
        "command": "coauthor.selectInputFile",
        "title": "Select Input File"
      },
      {
        "command": "coauthor.selectReferenceFile",
        "title": "Select Reference File"
      },
      {
        "command": "coauthor.selectAuxFile",
        "title": "Select Auxiliary File"
      },
      {
        "command": "coauthor.selectFigureFile",
        "title": "Select Figure File"
      },
      {
        "command": "coauthor.execute",
        "title": "Execute Agent"
      },
      {
        "command": "coauthor.merge",
        "title": "CoAuthor: Merge Files"
      }
    ],

    "viewsContainers": {
      "activitybar": [
        {
          "id": "coauthor",
          "title": "CoAuthor",
          "icon": "resources/scholarly-duck.svg"
        }
      ]
    },
    "views": {
      "coauthor": [
        {
          "type": "webview",
          "id": "coauthor.chatView",
          "name": "Your Favourite CoAuthor "
        },
        {
          "id": "coauthor.folderExplorer",
          "name": "CoAuthor Agents",
          "when": "workbenchState != empty"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "build": "npm run compile && vsce package --out releases/coauthor-$npm_package_version.vsix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.34",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-electron": "^2.4.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LionSR/coauthor-for-vs-code.git"
  },
  "license": "MIT",
  "author": "Sirui LU",
  "icon": "resources/scholarly-duck.png",
  "keywords": [
    "latex",
    "academic",
    "writing",
    "coauthor",
    "vscode"
  ],
  "bugs": {
    "url": "https://github.com/LionSR/coauthor-for-vs-code/issues"
  },
  "homepage": "https://github.com/LionSR/coauthor-for-vs-code#readme",
  "dependencies": {
    "@types/yaml": "^1.9.6",
    "jest-worker": "^29.7.0",
    "terser-webpack-plugin": "^5.3.10",
    "yaml": "^2.6.0"
  }
}
