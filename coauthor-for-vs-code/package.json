{
  "name": "coauthor",
  "displayName": "CoAuthor",
  "description": "CoAuthor: your never complain nor PUA nor on two-month holidays coauthor.",
  "version": "0.17.13",
  "publisher": "Sirui-Lu",
  "engines": {
    "vscode": "^1.93.1"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onView:coauthor",
    "onColorTheme"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "CoAuthor",
        "properties": {
          "coauthor.useOpenRouter": {
            "type": "boolean",
            "default": false,
            "description": "Whether to use OpenRouter for API calls when possible",
            "scope": "resource"
          },
          "coauthor.agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "correct",
              "derive",
              "polish",
              "draw",
              "ocr",
              "paper2cover",
              "paper2slide",
              "paper2poster",
              "paper2note",
              "polish_cover",
              "solve_qi"
            ],
            "description": "List of available agents",
            "scope": "resource"
          },
          "coauthor.models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "sonnet++",
              "sonnet+",
              "opus",
              "haiku+",
              "o3-",
              "o1",
              "o1preview",
              "o1-",
              "gpt4o",
              "gpt4o-",
              "gpt4ol",
              "gpt4t",
              "gemini2p",
              "gemini2f",
              "gemini2fT",
              "DSV3",
              "DSR1"
            ],
            "description": "List of available models",
            "scope": "resource"
          }
        }
      },
      {
        "title": "CoAuthor: File Handling",
        "properties": {
          "coauthor.files.included.inputDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Discrete-Time",
              "PapersEx"
            ],
            "description": "Directories to consider as the root for input files",
            "editPresentation": "multilineText",
            "order": 1
          },
          "coauthor.files.included.auxDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Discrete-Time",
              "PapersEx"
            ],
            "description": "Directories to consider as the root for auxiliary files",
            "editPresentation": "multilineText",
            "order": 2
          },
          "coauthor.files.included.figureDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Discrete-Time",
              "FiguresEx",
              "Figures",
              "Figs"
            ],
            "description": "Directories to include in the figure path",
            "editPresentation": "multilineText",
            "order": 3
          },
          "coauthor.files.included.figureExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".png",
              ".pdf",
              ".jpeg",
              ".jpg",
              ".svg",
              ".gif",
              ".bmp"
            ],
            "description": "File extensions to include when searching for figures",
            "editPresentation": "multilineText",
            "order": 4
          },
          "coauthor.files.included.inputExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md"
            ],
            "description": "File extensions to include when searching for input files",
            "editPresentation": "multilineText",
            "order": 5
          },
          "coauthor.files.included.referenceExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md"
            ],
            "description": "File extensions to include when searching for reference files",
            "editPresentation": "multilineText",
            "order": 6
          },
          "coauthor.files.included.auxiliaryExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".cls",
              ".md"
            ],
            "description": "File extensions to include when searching for auxiliary files",
            "editPresentation": "multilineText",
            "order": 7
          },
          "coauthor.files.included.editedExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex"
            ],
            "description": "File extensions to include when searching for edited files",
            "editPresentation": "multilineText",
            "order": 8
          },
          "coauthor.files.ignored.fileExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".pdf",
              ".bst",
              ".bib",
              ".json",
              ".py",
              ".ipynb",
              ".png",
              ".vsix",
              ".ts",
              ".js"
            ],
            "description": "File extensions to ignore when listing text files",
            "editPresentation": "multilineText",
            "order": 9
          },
          "coauthor.files.ignored.inputFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "command.tex",
              "preamble.tex"
            ],
            "description": "Files to ignore when listing input, sample, and edited files, but not auxiliary files",
            "editPresentation": "multilineText",
            "order": 10
          },
          "coauthor.files.ignored.auxiliaryKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "gpt",
              "sonnet",
              "haiku",
              "opus",
              "gemini",
              "llama",
              "egg-info"
            ],
            "description": "Additional keywords to ignore when listing auxiliary files, including model names",
            "editPresentation": "multilineText",
            "order": 11
          },
          "coauthor.files.ignored.figureDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "versions",
              "history"
            ],
            "description": "Directories to ignore in the figure path",
            "editPresentation": "multilineText",
            "order": 12
          },
          "coauthor.files.ignored.directories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "figures",
              "figs",
              "versions",
              "history",
              "stuff",
              "draft",
              "diff",
              "miscellaneous"
            ],
            "description": "Directories to ignore when listing files",
            "editPresentation": "multilineText",
            "order": 13
          },
          "coauthor.files.ignored.keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Makefile",
              "template",
              "_log",
              "_thinking",
              "_diff",
              "diff",
              "draw",
              "versions",
              "history",
              ".egg-info"
            ],
            "description": "Keywords to ignore when selecting files",
            "editPresentation": "multilineText",
            "order": 14
          }
        }
      },
      {
        "title": "CoAuthor: LaTeX",
        "properties": {
          "coauthor.latex.latexindentConfig": {
            "type": "string",
            "default": "",
            "description": "Path to latexindent configuration file",
            "editPresentation": "singlelineText",
            "order": 1
          }
        }
      },
      {
        "title": "CoAuthor: Python Environment",
        "properties": {
          "coauthor.python.virtualEnvString": {
            "type": "string",
            "default": "",
            "description": "Command to activate Python virtual environment (e.g., 'source venv/bin/activate' for Unix or 'venv\\Scripts\\activate.bat' for Windows). Leave empty to use system Python.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "CoAuthor: Execution",
        "properties": {
          "coauthor.execution.allowTerminalFallback": {
            "type": "boolean",
            "default": false,
            "description": "Whether to allow falling back to terminal execution when direct execution fails",
            "scope": "resource"
          }
        }
      },
      {
        "title": "CoAuthor: Git",
        "properties": {
          "coauthor.git.numberOfCommitsToShow": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "description": "Number of recent commits to show in the commit selection dropdown",
            "order": 1
          }
        }
      },
      {
        "title": "CoAuthor: Merge",
        "properties": {
          "coauthor.merge.defaultModel": {
            "type": "string",
            "default": "sonnet+",
            "enum": [
              "opus",
              "sonnet+",
              "gpt4t",
              "gpt4o",
              "gpt4o-"
            ],
            "enumDescriptions": [
              "Claude 3 Opus",
              "Claude 3 Sonnet+",
              "GPT-4 Turbo",
              "GPT-4O",
              "GPT-4O Mini"
            ],
            "description": "Default model to use for merge operations",
            "order": 1
          },
          "coauthor.merge.defaultReflect": {
            "type": "string",
            "default": "False",
            "enum": [
              "True",
              "False"
            ],
            "description": "Default reflect setting for merge operations",
            "order": 2
          }
        }
      },
      {
        "title": "CoAuthor: File Explorer",
        "properties": {
          "coauthor.explorer.agentsDirectory": {
            "type": "string",
            "default": "agents",
            "description": "Root path for the CoAuthor file explorer view. Can be absolute or relative to workspace root.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "CoAuthor: API Keys",
        "properties": {
          "coauthor.apiKeys.openai": {
            "type": "string",
            "default": "",
            "description": "OpenAI API key for GPT models",
            "scope": "application",
            "password": true
          },
          "coauthor.apiKeys.anthropic": {
            "type": "string",
            "default": "",
            "description": "Anthropic API key for Claude models",
            "scope": "application",
            "password": true
          },
          "coauthor.apiKeys.openRouter": {
            "type": "string",
            "default": "",
            "description": "OpenRouter API key for various models",
            "scope": "application",
            "password": true
          },
          "coauthor.apiKeys.google": {
            "type": "string",
            "default": "",
            "description": "Google API key for Gemini models",
            "scope": "application",
            "password": true
          }
        }
      }
    ],
    "commands": [
      {
        "command": "coauthor.cleanOutput",
        "title": "CoAuthor: Clean Output"
      },
      {
        "command": "coauthor.cleanBuild",
        "title": "CoAuthor: Clean Build"
      },
      {
        "command": "coauthor.indentTex",
        "title": "CoAuthor: Indent TeX"
      },
      {
        "command": "coauthor.getRecentCommits",
        "title": "CoAuthor: Get Recent Commits"
      },
      {
        "command": "coauthor.refreshCommits",
        "title": "CoAuthor: Refresh Commits"
      },
      {
        "command": "coauthor.indentCurrentTex",
        "title": "CoAuthor: Indent Current TeX"
      },
      {
        "command": "coauthor.countPdfPages",
        "title": "CoAuthor: Count PDF Pages"
      },
      {
        "command": "coauthor.encodeImageToBase64",
        "title": "CoAuthor: Encode Image to Base64"
      },
      {
        "command": "coauthor.convertPdfToImages",
        "title": "CoAuthor: Convert PDF to Images"
      },
      {
        "command": "coauthor.testPdfToImage",
        "title": "CoAuthor: Test PDF to Image Conversion"
      },
      {
        "command": "coauthor.extractFigurePaths",
        "title": "CoAuthor: Extract Figure Paths from LaTeX"
      },
      {
        "command": "coauthor.extractTikzFigures",
        "title": "CoAuthor: Extract TikZ Figures from Current File"
      },
      {
        "command": "coauthor.compileTikzFigures",
        "title": "CoAuthor: Compile TikZ Figures from Current File"
      },
      {
        "command": "coauthor.getTexCount",
        "title": "CoAuthor: Count Words in Current TeX File"
      },
      {
        "command": "coauthor.testConnection",
        "title": "CoAuthor: Test Text Connection Methods"
      },
      {
        "command": "coauthor.testAgentLoading",
        "title": "CoAuthor: Test Agent Loading"
      },
      {
        "command": "coauthor.loadSpecificAgent",
        "title": "CoAuthor: Load Specific Agent"
      },
      {
        "command": "coauthor.parseXml",
        "title": "CoAuthor: Parse XML Structure"
      },
      {
        "command": "coauthor.parseYaml",
        "title": "CoAuthor: Parse YAML Structure"
      },
      {
        "command": "coauthor.testYamlBrackets",
        "title": "CoAuthor: Test YAML Bracket Handling"
      },
      {
        "command": "coauthor.stopAgent",
        "title": "CoAuthor: Stop Agent"
      },
      {
        "command": "coauthor.execute",
        "title": "CoAuthor: Execute"
      },
      {
        "command": "coauthor.pack",
        "title": "CoAuthor: Pack Files"
      },
      {
        "command": "coauthor.clean",
        "title": "CoAuthor: Clean Files"
      },
      {
        "command": "coauthor.folderExplorer.newFile",
        "title": "New File",
        "icon": "$(new-file)"
      },
      {
        "command": "coauthor.folderExplorer.newFolder",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "coauthor.folderExplorer.rename",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "coauthor.folderExplorer.delete",
        "title": "Delete",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coauthor",
          "title": "CoAuthor",
          "icon": "resources/scholarly-duck.svg"
        }
      ]
    },
    "views": {
      "coauthor": [
        {
          "type": "webview",
          "id": "coauthor.chatView",
          "name": "Your Favourite CoAuthor",
          "contextualTitle": "CoAuthor"
        },
        {
          "type": "webview",
          "id": "coauthor.logView",
          "name": "CoAuthor: Tasks",
          "contextualTitle": "CoAuthor Tasks"
        },
        {
          "id": "coauthor.folderExplorer",
          "name": "Agents",
          "when": "workbenchState != empty"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "coauthor.folderExplorer.newFile",
          "when": "view == coauthor.folderExplorer",
          "group": "navigation"
        },
        {
          "command": "coauthor.folderExplorer.newFolder",
          "when": "view == coauthor.folderExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "coauthor.folderExplorer.newFile",
          "when": "view == coauthor.folderExplorer && viewItem == folder",
          "group": "1_modification"
        },
        {
          "command": "coauthor.folderExplorer.newFolder",
          "when": "view == coauthor.folderExplorer && viewItem == folder",
          "group": "1_modification"
        },
        {
          "command": "coauthor.folderExplorer.rename",
          "when": "view == coauthor.folderExplorer && viewItem != editing",
          "group": "2_modification"
        },
        {
          "command": "coauthor.folderExplorer.delete",
          "when": "view == coauthor.folderExplorer && viewItem != editing",
          "group": "3_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "build": "npm run compile && vsce package --out releases/coauthor-$npm_package_version.vsix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/difflib": "^0.2.7",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.68",
    "@types/nunjucks": "^3.2.5",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-electron": "^2.4.0",
    "chokidar": "^3.6.0",
    "eslint": "^8.57.0",
    "node-loader": "^2.1.0",
    "nunjucks": "^3.2.4",
    "path-browserify": "^1.0.1",
    "prettier": "^3.4.2",
    "spawn-sync": "^2.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LionSR/coauthor-for-vs-code.git"
  },
  "license": "MIT",
  "author": "Sirui LU",
  "icon": "resources/scholarly-duck.png",
  "keywords": [
    "latex",
    "academic",
    "writing",
    "coauthor",
    "vscode"
  ],
  "bugs": {
    "url": "https://github.com/LionSR/coauthor-for-vs-code/issues"
  },
  "homepage": "https://github.com/LionSR/coauthor-for-vs-code#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@types/yaml": "^1.9.6",
    "better-sqlite3": "^11.7.0",
    "diff-match-patch": "^1.0.5",
    "difflib": "^0.2.4",
    "fast-xml-parser": "^4.5.1",
    "glob": "^10.4.5",
    "jest-worker": "^29.7.0",
    "jimp": "^1.6.0",
    "nunjucks": "^3.2.4",
    "openai": "^4.78.1",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.1.3",
    "sortablejs": "^1.15.6",
    "split.js": "^1.6.5",
    "terser-webpack-plugin": "^5.3.10",
    "winston": "^3.17.0",
    "yaml": "^2.6.1"
  }
}
