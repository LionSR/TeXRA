          },
          {
            "object": "process",
            "property": "stderr",
            "message": "Write output through runtime/logSinks.ts."
          }
        ]
      }
    },
    {
      "files": ["packages/cli/src/runtime/cliContext.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "console",
            "property": "log",
            "message": "Write output through runtime/logSinks.ts."
          },
          {
            "object": "console",
            "property": "error",
            "message": "Write output through runtime/logSinks.ts."
          },
          {
            "object": "console",
            "property": "warn",
            "message": "Write output through runtime/logSinks.ts."
          },
          {
            "object": "process",
            "property": "exitCode",
            "message": "Write output through runtime/logSinks.ts."
          }
        ]
      }
    },
    {
      "files": [
        "packages/cli/src/bin/texra.ts",
        "packages/cli/src/bin/texraServe.ts",
        "packages/cli/src/runtime/logSinks.ts",
        "packages/cli/src/init/runInitWizard.tsx",
        "packages/cli/src/config/runConfigTui.tsx"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "process",
            "property": "argv",
            "message": "Read process input through runtime/cliContext.ts."
          },
          {
            "object": "process",
            "property": "env",
            "message": "Read process input through runtime/cliContext.ts."
          },
          {
            "object": "process",
            "property": "cwd",
            "message": "Read process input through runtime/cliContext.ts."
          }
        ]
      }
    },
    {
      "files": ["packages/cli/src/chat/tui/runChatTui.tsx"],
      "rules": {
        "no-restricted-properties": "off"
      }
    }
  ]
}
