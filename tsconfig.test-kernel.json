{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": [
    "src/test-kernel/**/*.ts",
    "packages/*/test/**/*.ts",
    "scripts/fixtures/*.ts"
  ],
  "exclude": ["node_modules"]
}
