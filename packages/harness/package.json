{
  "name": "@texra-ai/harness",
  "version": "0.1.0",
  "description": "Embeddable TeXRA agent runtime",
  "license": "Apache-2.0",
  "author": "TeXRA.ai",
  "homepage": "https://texra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LionSR/TeXRA.git"
  },
  "bugs": {
    "url": "https://github.com/LionSR/TeXRA/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "NOTICE.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/packages/harness/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/types/packages/harness/src/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./plugins": {
      "types": "./dist/types/packages/harness/src/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./node": {
      "types": "./dist/types/packages/harness/src/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "example:packed": "npm run build && rm -f example/*.tgz && corepack pnpm --filter @texra-ai/llm pack --pack-destination \"$PWD/example\" && corepack pnpm pack --pack-destination example && mv example/texra-ai-harness-*.tgz example/harness.tgz && mv example/texra-ai-llm-*.tgz example/llm.tgz && cd example && npm install ./llm.tgz ./harness.tgz && npm start",
    "prepack": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent ?? '')) { console.error('Pack and publish with pnpm: only it applies publishConfig.exports and resolves workspace: versions.'); process.exit(1); }\" && npm run build"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@jitl/quickjs-wasmfile-release-sync": "catalog:",
    "@texra-ai/llm": "workspace:*",
    "date-fns": "catalog:",
    "diff": "catalog:",
    "escape-string-regexp": "catalog:",
    "glob": "catalog:",
    "http-status-codes": "catalog:",
    "ignore": "catalog:",
    "image-size": "catalog:",
    "ipaddr.js": "catalog:",
    "is-wsl": "catalog:",
    "llm-zoo": "catalog:",
    "lru-cache": "catalog:",
    "mime-types": "catalog:",
    "nanoid": "catalog:",
    "nunjucks": "catalog:",
    "pathe": "catalog:",
    "postal-mime": "catalog:",
    "pretty-bytes": "catalog:",
    "pretty-ms": "catalog:",
    "quickjs-emscripten-core": "catalog:",
    "safe-stable-stringify": "catalog:",
    "shell-quote": "catalog:",
    "turndown": "catalog:",
    "turndown-plugin-gfm": "catalog:",
    "undici": "catalog:",
    "which": "catalog:",
    "write-file-atomic": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/nunjucks": "^3.2.6",
    "@types/turndown": "^5.0.6",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
