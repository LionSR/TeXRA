{
  "name": "@texra-ai/harness",
  "version": "0.1.0",
  "description": "Embeddable agent runtime from TeXRA, in Effect: sessions, durable runs, tools and plugins",
  "keywords": [
    "agent",
    "llm",
    "effect",
    "harness",
    "texra"
  ],
  "license": "Apache-2.0",
  "author": "TeXRA.ai",
  "homepage": "https://texra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LionSR/TeXRA.git",
    "directory": "packages/harness"
  },
  "bugs": {
    "url": "https://github.com/LionSR/TeXRA/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "NOTICE.txt"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/types/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./transcript": {
      "types": "./dist/types/transcriptEntry.d.ts",
      "import": "./dist/transcript.js"
    },
    "./plugins": {
      "types": "./dist/types/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "example:packed": "node scripts/example-packed.mjs",
    "prepack": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent ?? '')) { console.error('Pack and publish with pnpm: only it applies publishConfig.exports and resolves workspace: versions.'); process.exit(1); }\" && npm run build"
  },
  "dependencies": {
    "diff": "catalog:",
    "escape-string-regexp": "catalog:",
    "glob": "catalog:",
    "http-status-codes": "catalog:",
    "ignore": "catalog:",
    "image-size": "catalog:",
    "ipaddr.js": "catalog:",
    "is-wsl": "catalog:",
    "llm-zoo": "catalog:",
    "lru-cache": "catalog:",
    "mime-types": "catalog:",
    "nanoid": "catalog:",
    "nunjucks": "catalog:",
    "pathe": "catalog:",
    "postal-mime": "catalog:",
    "pretty-bytes": "catalog:",
    "pretty-ms": "catalog:",
    "safe-stable-stringify": "catalog:",
    "shell-quote": "catalog:",
    "turndown": "catalog:",
    "turndown-plugin-gfm": "catalog:",
    "undici": "catalog:",
    "which": "catalog:",
    "write-file-atomic": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:peers",
    "@effect/sql-sqlite-node": "catalog:peers",
    "@texra-ai/llm": "workspace:^",
    "effect": "catalog:peers",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@jitl/quickjs-wasmfile-release-sync": "catalog:",
    "@texra-ai/llm": "workspace:*",
    "@types/mime-types": "^3.0.1",
    "@types/nunjucks": "^3.2.6",
    "@types/turndown": "^5.0.6",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "quickjs-emscripten-core": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
