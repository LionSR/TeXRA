    "tar": "^7.5.22",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^7.29.0",
    "vscode-jsonrpc": "^9.0.1",
    "which": "^5.0.0",
    "write-file-atomic": "^7.0.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.4.3"
  }
}
