{
  "name": "@texra-ai/agent",
  "version": "0.41.0",
  "description": "Embeddable TeXRA agent runtime",
  "license": "Apache-2.0",
  "author": "TeXRA.ai",
  "homepage": "https://texra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LionSR/TeXRA.git"
  },
  "bugs": {
    "url": "https://github.com/LionSR/TeXRA/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "NOTICE.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/packages/agent/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/types/packages/agent/src/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./effect": {
      "types": "./dist/types/packages/agent/src/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./node": {
      "types": "./dist/types/packages/agent/src/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "example:packed": "npm run build && rm -f example/*.tgz && corepack pnpm pack --pack-destination example && mv example/texra-ai-agent-*.tgz example/agent.tgz && cd example && npm install ./agent.tgz && npm start",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@cantoo/pdf-lib": "catalog:",
    "@date-fns/tz": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@google/genai": "catalog:",
    "@jamesgopsill/crossref-client": "catalog:",
    "@jitl/quickjs-wasmfile-release-sync": "catalog:",
    "@octokit/request": "catalog:",
    "@octokit/request-error": "catalog:",
    "@openai/codex-sdk": "catalog:",
    "@openrouter/sdk": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "acorn": "catalog:",
    "acorn-walk": "catalog:",
    "arxiv-client": "catalog:",
    "bibtex": "catalog:",
    "content-disposition": "catalog:",
    "date-fns": "catalog:",
    "diff": "catalog:",
    "diff-match-patch": "catalog:",
    "escape-string-regexp": "catalog:",
    "execa": "catalog:",
    "fast-xml-parser": "catalog:",
    "glob": "catalog:",
    "http-status-codes": "catalog:",
    "identifiers-arxiv": "catalog:",
    "ignore": "catalog:",
    "image-size": "catalog:",
    "ipaddr.js": "catalog:",
    "is-network-error": "catalog:",
    "is-wsl": "catalog:",
    "ky": "catalog:",
    "llm-zoo": "catalog:",
    "lru-cache": "catalog:",
    "mime-types": "catalog:",
    "nanoid": "catalog:",
    "nunjucks": "catalog:",
    "openai": "catalog:",
    "pathe": "catalog:",
    "pdf2pic": "catalog:",
    "postal-mime": "catalog:",
    "pretty-ms": "catalog:",
    "quickjs-emscripten-core": "catalog:",
    "safe-stable-stringify": "catalog:",
    "shell-quote": "catalog:",
    "tar": "catalog:",
    "tree-kill": "catalog:",
    "turndown": "catalog:",
    "turndown-plugin-gfm": "catalog:",
    "undici": "catalog:",
    "which": "catalog:",
    "write-file-atomic": "catalog:",
    "ws": "^8.21.3",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.115",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
