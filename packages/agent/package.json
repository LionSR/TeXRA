    "perfect-debounce": "^2.1.0",
    "pluralize": "^8.0.0",
    "postal-mime": "^2.7.6",
    "pretty-bytes": "^7.1.1",
    "pretty-ms": "^9.3.0",
    "proper-lockfile": "^4.1.2",
