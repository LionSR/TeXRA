{
  "name": "@texra-ai/agent",
  "version": "0.40.2",
  "description": "Embeddable TeXRA agent runtime",
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "TeXRA.ai",
  "homepage": "https://texra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/texra-ai/texra-issues.git"
  },
  "bugs": {
    "url": "https://github.com/texra-ai/texra-issues/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/packages/agent/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/types/packages/agent/src/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./node": {
      "types": "./dist/types/packages/agent/src/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:bundle": "node scripts/bundle.mjs",
    "build:types": "tsc --checkers 8 -p ../../tsconfig.build.json && node scripts/rewrite-declaration-aliases.mjs",
    "check:artifacts": "node scripts/validate-artifacts.mjs",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@anthropic-ai/sdk": "^0.116.0",
    "@cantoo/pdf-lib": "^2.8.1",
    "@google/genai": "^2.16.0",
    "@jamesgopsill/crossref-client": "^1.1.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@octokit/request": "^10.0.13",
    "@octokit/request-error": "^7.1.1",
    "@openai/codex-sdk": "^0.147.0",
    "@openrouter/sdk": "^1.2.18",
    "@supabase/supabase-js": "2.112.2",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "arxiv-client": "^0.0.9",
    "async-mutex": "^0.5.0",
    "bibtex": "^0.9.0",
    "content-disposition": "^2.0.1",
    "data-uri-to-buffer": "^7.0.0",
    "date-fns": "^4.4.0",
    "deepmerge": "^4.3.1",
    "delay": "^7.0.0",
    "diff-match-patch": "^1.0.5",
    "escape-string-regexp": "^5.0.0",
    "execa": "^10.0.1",
    "fast-json-stable-stringify": "^2.1.0",
    "fast-xml-parser": "^5.10.1",
    "glob": "^13.0.6",
    "http-status-codes": "^2.3.0",
    "identifiers-arxiv": "^0.1.1",
    "ignore": "^7.0.6",
