{
  "name": "llm-model-registry",
  "version": "1.0.0",
  "description": "Comprehensive registry of LLM model configurations with pricing, capabilities, and provider details",
  "keywords": [
    "llm",
    "language-models",
    "ai",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "gemini",
    "deepseek",
    "model-config",
    "pricing",
    "capabilities"
  ],
  "author": "LionSR",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/texra-ai/llm-model-registry"
  },
  "homepage": "https://github.com/texra-ai/llm-model-registry",
  "bugs": {
    "url": "https://github.com/texra-ai/llm-model-registry/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "require": "./dist/providers/index.cjs",
      "types": "./dist/providers/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas.js",
      "require": "./dist/schemas.cjs",
      "types": "./dist/schemas.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
