{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../src/shared/*"],
      "@common/state": ["src/common/state"],
      "@common/state/*": ["src/common/state/*"],
      "@common/webview": ["src/common/webview"],
      "@common/webview/*": ["src/common/webview/*"],
      "@common/*": ["../../src/common/*"],
      "@webview/*": ["src/webview/*"],
      "@agent/*": ["../../src/agent/*"],
      "@frontend/*": ["src/frontend/*"],
      "@hosts/*": ["../../src/hosts/*"],
      "@utils/*": ["../../src/utils/*"],
      "@logger": ["../../src/logger"],
      "@logger/*": ["../../src/logger/*"],
      "@telemetry": ["../../src/telemetry"],
      "@telemetry/*": ["../../src/telemetry/*"],
      "@transcript": ["../../src/transcript"],
      "@transcript/*": ["../../src/transcript/*"],
      "@latex/*": ["../../src/latex/*"],
      "@commands/*": ["src/commands/*"],
      "@resources/*": ["resources/*"],
      "@model": ["../../src/model"],
      "@model/*": ["../../src/model/*"],
      "@skills/*": ["../../src/skills/*"],
      "@housekeeping": ["../../src/housekeeping"],
      "@housekeeping/*": ["../../src/housekeeping/*"],
      "@progressView/*": ["src/progressView/*"],
      "@settingsView/*": ["src/settingsView/*"],
      "@replacement/*": ["../../src/replacement/*"],
      "@tools/*": ["../../src/tools/*"],
      "@types/*": ["../../src/types/*"],
      "@eventBus/*": ["../../src/eventBus/*"],
      "@auth/*": ["../../src/auth/*"],
      "@platform/*": ["../../src/platform/*"],
      "turndown-plugin-gfm": ["../../src/types/ambient.d.ts"],
      "data-uri-to-buffer": [
        "../../node_modules/data-uri-to-buffer/dist/node.d.ts"
      ],
      "@openrouter/sdk": ["../../node_modules/@openrouter/sdk/esm/index.d.ts"],
      "@openrouter/sdk/models": [
        "../../node_modules/@openrouter/sdk/esm/models/index.d.ts"
      ],
      "@openrouter/sdk/models/errors": [
        "../../node_modules/@openrouter/sdk/esm/models/errors/index.d.ts"
      ],
      "@controllers/*": ["../../src/controllers/*"]
    },
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../../src/types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "vite.config.ts",
    "esbuild.config.mjs"
  ]
}
