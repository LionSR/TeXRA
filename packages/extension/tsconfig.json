{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "sourceMap": false,
    "paths": {
      "@shared/*": [
        "./../../src/shared/*.ts",
        "./../../src/shared/*/index.ts",
        "./../../src/shared/*"
      ],
      "@common/state": ["./src/common/state/index.ts"],
      "@common/state/*": [
        "./src/common/state/*.ts",
        "./src/common/state/*/index.ts",
        "./src/common/state/*"
      ],
      "@common/webview": ["./src/common/webview/index.ts"],
      "@common/webview/*": [
        "./src/common/webview/*.ts",
        "./src/common/webview/*/index.ts",
        "./src/common/webview/*"
      ],
      "@common/*": [
        "./../../src/common/*.ts",
        "./../../src/common/*/index.ts",
        "./../../src/common/*"
      ],
      "@webview/*": [
        "./src/webview/*.ts",
        "./src/webview/*/index.ts",
        "./src/webview/*"
      ],
      "@agent/*": [
        "./../../src/agent/*.ts",
        "./../../src/agent/*/index.ts",
        "./../../src/agent/*"
      ],
      "@frontend/*": [
        "./src/frontend/*.ts",
        "./src/frontend/*/index.ts",
        "./src/frontend/*"
      ],
      "@hosts/*": [
        "./../../src/hosts/*.ts",
        "./../../src/hosts/*/index.ts",
        "./../../src/hosts/*"
      ],
      "@utils/*": [
        "./../../src/utils/*.ts",
        "./../../src/utils/*/index.ts",
        "./../../src/utils/*"
      ],
      "@logger/*": [
        "./../../src/logger/*.ts",
        "./../../src/logger/*/index.ts",
        "./../../src/logger/*"
      ],
      "@telemetry/*": [
        "./../../src/telemetry/*.ts",
        "./../../src/telemetry/*/index.ts",
        "./../../src/telemetry/*"
      ],
      "@transcript": ["./../../src/transcript/index.ts"],
      "@transcript/*": [
        "./../../src/transcript/*.ts",
        "./../../src/transcript/*/index.ts",
        "./../../src/transcript/*"
      ],
      "@latex/*": [
        "./../../src/latex/*.ts",
        "./../../src/latex/*/index.ts",
        "./../../src/latex/*"
      ],
      "@commands/*": [
        "./src/commands/*.ts",
        "./src/commands/*/index.ts",
        "./src/commands/*"
      ],
      "@resources/*": [
        "./resources/*.ts",
        "./resources/*/index.ts",
        "./resources/*"
      ],
      "@model/*": [
        "./../../src/model/*.ts",
        "./../../src/model/*/index.ts",
        "./../../src/model/*"
      ],
      "@skills/*": [
        "./../../src/skills/*.ts",
        "./../../src/skills/*/index.ts",
        "./../../src/skills/*"
      ],
      "@housekeeping": ["./../../src/housekeeping/index.ts"],
      "@housekeeping/*": [
        "./../../src/housekeeping/*.ts",
        "./../../src/housekeeping/*/index.ts",
        "./../../src/housekeeping/*"
      ],
      "@progressView/*": [
        "./src/progressView/*.ts",
        "./src/progressView/*/index.ts",
        "./src/progressView/*"
      ],
      "@settingsView/*": [
        "./src/settingsView/*.ts",
        "./src/settingsView/*/index.ts",
        "./src/settingsView/*"
      ],
      "@replacement/*": [
        "./../../src/replacement/*.ts",
        "./../../src/replacement/*/index.ts",
        "./../../src/replacement/*"
      ],
      "@tools/*": [
        "./../../src/tools/*.ts",
        "./../../src/tools/*/index.ts",
        "./../../src/tools/*"
      ],
      "@eventBus/*": [
        "./../../src/eventBus/*.ts",
        "./../../src/eventBus/*/index.ts",
        "./../../src/eventBus/*"
      ],
      "@auth/*": [
        "./../../src/auth/*.ts",
        "./../../src/auth/*/index.ts",
        "./../../src/auth/*"
      ],
      "@platform/*": [
        "./../../src/platform/*.ts",
        "./../../src/platform/*/index.ts",
        "./../../src/platform/*"
      ],
      "turndown-plugin-gfm": ["./../../src/types/ambient.d.ts"],
      "data-uri-to-buffer": [
        "./../../node_modules/data-uri-to-buffer/dist/node.d.ts"
      ],
      "@openrouter/sdk": [
        "./../../node_modules/@openrouter/sdk/esm/index.d.ts"
      ],
      "@openrouter/sdk/models": [
        "./../../node_modules/@openrouter/sdk/esm/models/index.d.ts"
      ],
      "@openrouter/sdk/models/errors": [
        "./../../node_modules/@openrouter/sdk/esm/models/errors/index.d.ts"
      ],
      "@controllers/*": [
        "./../../src/controllers/*.ts",
        "./../../src/controllers/*/index.ts",
        "./../../src/controllers/*"
      ]
    },
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../../src/types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "vite.config.ts",
    "esbuild.config.mjs"
  ]
}
