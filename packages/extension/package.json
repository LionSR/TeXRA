{
  "name": "texra",
  "displayName": "TeXRA",
  "description": "An open-source AI theorist for LaTeX, derivations, and Lean 4.",
  "version": "0.41.0",
  "publisher": "texra-ai",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Chat",
    "Machine Learning",
    "Linters",
    "Formatters",
    "AI",
    "Education",
    "Data Science"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "TeXRA runs AI agents that read workspace files and execute shell commands (LaTeX compilation, bash tools, external MCP tools). Open trusted workspaces only."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "texra.createSampleProject",
        "title": "Create Sample Project",
        "category": "TeXRA"
      },
      {
        "command": "texra.runSetupAssistant",
        "title": "Run Setup Assistant",
        "category": "TeXRA",
        "icon": "$(rocket)"
      },
      {
        "command": "texra.openGettingStarted",
        "title": "Open Getting Started Walkthrough",
        "category": "TeXRA",
        "icon": "$(mortar-board)"
      },
      {
        "command": "texra.cleanBuild",
        "title": "Delete All build/ Folders in Project",
        "category": "TeXRA",
        "icon": "$(close-all)"
      },
      {
        "command": "texra.cloneOverleafProject",
        "title": "Clone Overleaf/ShareLaTeX Project",
        "category": "TeXRA",
        "icon": "$(repo-clone)"
      },
      {
        "command": "texra.indentCurrentTeX",
        "title": "Format Current LaTeX File",
        "category": "TeXRA",
        "icon": "$(indent)",
        "enablement": "!virtualWorkspace"
      },
      {
        "command": "texra.fixCompilation",
        "title": "Fix LaTeX Compilation Errors",
        "category": "TeXRA",
        "icon": "$(wrench)",
        "enablement": "!virtualWorkspace"
      },
      {
        "command": "texra.getTeXCount",
        "title": "Count Words in Current LaTeX File",
        "category": "TeXRA",
        "icon": "$(symbol-number)",
        "enablement": "!virtualWorkspace"
      },
      {
        "command": "texra.compileTikzFigures",
        "title": "Compile TikZ Figures from Current File",
        "category": "TeXRA"
      },
      {
        "command": "texra.downloadArXivSource",
        "title": "Download arXiv Source",
        "category": "TeXRA"
      },
      {
        "command": "texra.execute",
        "title": "Run Task",
        "category": "TeXRA"
      },
      {
        "command": "texra.setApiKey",
        "title": "Set API Key",
        "category": "TeXRA"
      },
      {
        "command": "texra.removeApiKey",
        "title": "Remove API Key",
        "category": "TeXRA"
      },
      {
        "command": "texra.auth.chatgpt.signIn",
        "title": "Sign In with ChatGPT Subscription",
        "category": "TeXRA",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "texra.showMemory",
        "title": "Memory Settings",
        "category": "TeXRA",
        "icon": "$(database)"
      },
      {
        "command": "texra.showModels",
        "title": "Model Settings",
        "category": "TeXRA",
        "icon": "$(hubot)"
      },
      {
        "command": "texra.showTools",
        "title": "Plugin Settings",
        "category": "TeXRA",
        "icon": "$(extensions)"
      },
      {
        "command": "texra.showApprovalSettings",
        "title": "Approval Settings",
        "category": "TeXRA",
        "icon": "$(shield)"
      },
      {
        "command": "texra.showGitSettings",
        "title": "Git Settings",
        "category": "TeXRA",
        "icon": "$(git-branch)"
      },
      {
        "command": "texra.showMainView",
        "title": "New Task",
        "category": "TeXRA",
        "icon": "$(edit)"
      },
      {
        "command": "texra.showProgressView",
        "title": "Show Tasks",
        "category": "TeXRA",
        "icon": "$(eye)"
      },
      {
        "command": "texra.openProgressViewInTab",
        "title": "Open Tasks in Editor",
        "shortTitle": "Open in Editor",
        "category": "TeXRA",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "texra.showDashboard",
        "title": "Open Settings",
        "shortTitle": "Settings",
        "category": "TeXRA",
        "icon": "$(gear)"
      },
      {
        "command": "texra.replyComment",
        "title": "Reply",
        "category": "TeXRA"
      },
      {
        "command": "texra.resolveCommentThread",
        "title": "Resolve",
        "category": "TeXRA",
        "icon": "$(check)"
      },
      {
        "command": "texra.unresolveCommentThread",
        "title": "Reopen",
        "category": "TeXRA",
        "icon": "$(history)"
      }
    ],
    "walkthroughs": [
      {
        "id": "texra.gettingStarted",
        "title": "Get started with TeXRA",
        "description": "Connect a model, open your project, run the setup assistant, and start your first task.",
        "steps": [
          {
            "id": "texra.gettingStarted.signIn",
            "title": "Connect a model",
            "description": "Sign in with a ChatGPT or Grok subscription, or add an API key (Anthropic, OpenAI, Google, DeepSeek, Kimi, GLM, and more).\n\n[Sign in with ChatGPT](command:texra.auth.chatgpt.signIn)\n\n[Set API key](command:texra.setApiKey)",
            "media": {
              "image": "resources/walkthroughs/media/api-key-setup.png",
              "altText": "Screenshot of the provider API key settings"
            },
            "completionEvents": [
              "onCommand:texra.auth.chatgpt.signIn",
              "onCommand:texra.setApiKey"
            ]
          },
          {
            "id": "texra.gettingStarted.openPaper",
            "title": "Open a project",
            "description": "Open your LaTeX project folder, or start with one of the options below.\n\n[Open folder](command:workbench.action.files.openFolder)\n\n[Create sample project](command:texra.createSampleProject)\n\n[Clone from Overleaf](command:texra.walkthroughWorkspaceAction?%5B%22texra.cloneOverleafProject%22%5D)\n\n[Download from arXiv](command:texra.walkthroughWorkspaceAction?%5B%22texra.downloadArXivSource%22%5D)",
            "media": {
              "image": "resources/walkthroughs/media/file-selection.png",
              "altText": "Screenshot of a project's files attached to a new task"
            },
            "completionEvents": [
              "onContext:workspaceFolderCount == 1",
              "onCommand:texra.createSampleProject",
              "onCommand:texra.cloneOverleafProject",
              "onCommand:texra.downloadArXivSource"
            ]
          },
          {
            "id": "texra.gettingStarted.setupAssistant",
            "title": "Run the Setup Assistant",
            "description": "Checks your LaTeX tools, helps install anything missing, and runs a quick test edit with diff preview. Asks before every command.\n\n[Run Setup Assistant](command:texra.walkthroughWorkspaceAction?%5B%22texra.runSetupAssistant%22%5D)",
            "media": {
              "image": "resources/walkthroughs/media/texra-progressboard.png",
              "altText": "Screenshot of a TeXRA task"
            },
            "completionEvents": [
              "onCommand:texra.runSetupAssistant"
            ]
          },
          {
            "id": "texra.gettingStarted.firstTask",
            "title": "Start your first task",
            "description": "Open **New task**, describe what you need (e.g., \"tighten the introduction\"), and send. Track running or past work under **Tasks**.\n\n[New task](command:texra.walkthroughWorkspaceAction?%5B%22texra.showMainView%22%5D)\n\nNew projects default to **Auto-approve**; switch to **Ask** or **Block** anytime in **Settings → General → Approval**.\n\n[Approval settings](command:texra.walkthroughWorkspaceAction?%5B%22texra.showApprovalSettings%22%5D)",
            "media": {
              "image": "resources/walkthroughs/media/vscode-compare.png",
              "altText": "Screenshot of the VS Code diff view"
            },
            "completionEvents": [
              "onCommand:texra.showMainView"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "texra",
          "title": "TeXRA",
          "icon": "resources/logo-128x128.svg"
        }
      ]
    },
    "views": {
      "texra": [
        {
          "type": "webview",
          "id": "texra.mainView",
          "name": "TeXRA",
          "contextualTitle": "TeXRA"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "when": "texra.activated && editorLangId == latex",
          "command": "texra.fixCompilation",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "texra.createSampleProject",
          "when": "texra.activated"
        },
        {
          "command": "texra.runSetupAssistant",
          "when": "texra.activated"
        },
        {
          "command": "texra.openGettingStarted",
          "when": "texra.activated"
        },
        {
          "command": "texra.cleanBuild",
          "when": "texra.activated"
        },
        {
          "command": "texra.cloneOverleafProject",
          "when": "texra.activated"
        },
        {
          "command": "texra.indentCurrentTeX",
          "when": "texra.activated"
        },
        {
          "command": "texra.fixCompilation",
          "when": "texra.activated"
        },
        {
          "command": "texra.getTeXCount",
          "when": "texra.activated"
        },
        {
          "command": "texra.compileTikzFigures",
          "when": "texra.activated"
        },
        {
          "command": "texra.downloadArXivSource",
          "when": "texra.activated"
        },
        {
          "command": "texra.execute",
          "when": "false"
        },
        {
          "command": "texra.setApiKey",
          "when": "texra.activated"
        },
        {
          "command": "texra.removeApiKey",
          "when": "false"
        },
        {
          "command": "texra.auth.chatgpt.signIn",
          "when": "texra.activated"
        },
        {
          "command": "texra.showMemory",
          "when": "false"
        },
        {
          "command": "texra.showModels",
          "when": "false"
        },
        {
          "command": "texra.showTools",
          "when": "false"
        },
        {
          "command": "texra.showApprovalSettings",
          "when": "false"
        },
        {
          "command": "texra.showGitSettings",
          "when": "false"
        },
        {
          "command": "texra.showMainView",
          "when": "texra.activated"
        },
        {
          "command": "texra.showProgressView",
          "when": "texra.activated"
        },
        {
          "command": "texra.openProgressViewInTab",
          "when": "texra.activated"
        },
        {
          "command": "texra.showDashboard",
          "when": "texra.activated"
        },
        {
          "command": "texra.replyComment",
          "when": "false"
        },
        {
          "command": "texra.resolveCommentThread",
          "when": "false"
        },
        {
          "command": "texra.unresolveCommentThread",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "texra.replyComment",
          "group": "inline",
          "when": "commentController == texra.inlineComments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "texra.resolveCommentThread",
          "group": "inline@1",
          "when": "commentController == texra.inlineComments && commentThread == texraInlineCommentOpen"
        },
        {
          "command": "texra.unresolveCommentThread",
          "group": "inline@1",
          "when": "commentController == texra.inlineComments && commentThread == texraInlineCommentResolved"
        }
      ]
    },
    "keybindings": [
      {
        "command": "texra.execute",
        "key": "ctrl+alt+e",
        "mac": "cmd+option+e",
        "when": "texra.activated"
      },
      {
        "command": "texra.showMainView",
        "key": "ctrl+alt+m",
        "mac": "cmd+option+m",
        "when": "texra.activated"
      },
      {
        "command": "texra.showProgressView",
        "key": "ctrl+alt+p",
        "mac": "cmd+option+p",
        "when": "texra.activated"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LionSR/TeXRA.git"
  },
  "license": "Apache-2.0",
  "author": "TeXRA.ai",
  "icon": "resources/logo-512x512.png",
  "keywords": [
    "latex",
    "tex",
    "academic",
    "writing",
    "research",
    "agent",
    "llm",
    "AI",
    "Claude",
    "OpenAI",
    "Gemini",
    "DeepSeek",
    "Grok",
    "GPT"
  ],
  "bugs": {
    "url": "https://github.com/LionSR/TeXRA/issues"
  },
  "homepage": "https://texra.ai",
  "devDependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@lit-labs/signals": "^0.3.0",
    "@texra-ai/worldline": "workspace:*",
    "@texra-ai/llm": "workspace:*",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^4.1.1",
    "concurrently": "^10.0.7",
    "effect": "catalog:",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "vite": "^8.3.8"
  },
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "prepare:docs": "node scripts/copy-docs.mjs",
    "prepare:trace-viewer-assets": "corepack pnpm --filter @texra/trace-viewer run build",
    "bundle:serve": "node scripts/build-serve.mjs",
    "esbuild:ext": "node esbuild.config.mjs",
    "esbuild:ext:watch": "node esbuild.config.mjs --watch",
    "esbuild:ext:prod": "node esbuild.config.mjs --production",
    "vite:webviews": "for v in progressView settingsView; do VITE_WEBVIEW=$v vite build; done",
    "vite:webviews:dev": "for v in progressView settingsView; do VITE_WEBVIEW=$v vite build --mode development; done",
    "vite:webviews:watch": "concurrently \"VITE_WEBVIEW=progressView vite build --watch --mode development\" \"VITE_WEBVIEW=settingsView vite build --watch --mode development\"",
    "compile:fast": "corepack pnpm run clean:dist && concurrently \"corepack pnpm run prepare:trace-viewer-assets\" \"corepack pnpm run esbuild:ext\" \"corepack pnpm run bundle:serve\" \"corepack pnpm run vite:webviews:dev\"",
    "watch:fast": "echo \"[texra-watch] starting\" && corepack pnpm run compile:fast && echo \"[texra-watch] initial build complete\" && concurrently \"corepack pnpm run esbuild:ext:watch\" \"corepack pnpm run vite:webviews:watch\"",
    "package:fast": "corepack pnpm run clean:dist && concurrently \"corepack pnpm run prepare:trace-viewer-assets\" \"corepack pnpm run esbuild:ext:prod\" \"corepack pnpm run bundle:serve\" \"corepack pnpm run vite:webviews\"",
    "build:fast": "corepack pnpm run package:fast && corepack pnpm run prepare:docs && mkdir -p ../../releases && vsce package --no-dependencies $VSCE_PACKAGE_FLAGS --out ../../releases/texra-$npm_package_version.vsix"
  }
}
