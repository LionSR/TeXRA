          "command": "texra.replyComment",
          "group": "inline",
          "when": "commentController == texra.inlineComments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "texra.resolveCommentThread",
          "group": "inline@1",
          "when": "commentController == texra.inlineComments && commentThread == texraInlineCommentOpen"
        },
        {
          "command": "texra.unresolveCommentThread",
          "group": "inline@1",
          "when": "commentController == texra.inlineComments && commentThread == texraInlineCommentResolved"
        }
      ]
    },
