        "enablement": "!virtualWorkspace"
      },
      {
        "command": "texra.extractTikzFigures",
        "title": "Extract TikZ Figures from Current File",
        "category": "TeXRA"
      },
      {
        "command": "texra.compileTikzFigures",
        "title": "Compile TikZ Figures from Current File",
        "category": "TeXRA"
      },
      {
        "command": "texra.downloadArXivSource",
        "title": "Download arXiv Source",
        "category": "TeXRA"
      },
      {
        "command": "texra.execute",
        "title": "Execute Agent",
        "category": "TeXRA"
      },
      {
        "command": "texra.createAgentWithAI",
        "title": "Create AI Agent",
        "category": "TeXRA",
        "icon": "$(sparkle)"
      },
      {
        "command": "texra.setApiKey",
        "title": "Set API Key",
        "category": "TeXRA"
      },
      {
        "command": "texra.removeApiKey",
        "title": "Remove API Key",
        "category": "TeXRA"
      },
      {
        "command": "texra.auth.signIn",
        "title": "Sign In to TeXRA Account (Remote Agents)",
        "category": "TeXRA",
        "icon": "$(sign-in)"
      },
      {
        "command": "texra.auth.chatgpt.signIn",
        "title": "Sign In with ChatGPT Subscription",
        "category": "TeXRA",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "texra.auth.signOut",
        "title": "Sign Out",
        "category": "TeXRA",
        "icon": "$(sign-out)"
      },
      {
        "command": "texra.auth.viewProfile",
        "title": "Account Settings",
        "category": "TeXRA",
        "icon": "$(account)"
      },
      {
        "command": "texra.showMemory",
        "title": "Memory Settings",
        "category": "TeXRA",
        "icon": "$(database)"
      },
      {
        "command": "texra.showModels",
        "title": "Model Settings",
        "category": "TeXRA",
        "icon": "$(hubot)"
      },
      {
        "command": "texra.showAgents",
        "title": "Agent Settings",
        "category": "TeXRA",
        "icon": "$(symbol-method)"
      },
      {
        "command": "texra.showTools",
        "title": "Tool Settings",
        "category": "TeXRA",
        "icon": "$(tools)"
      },
      {
        "command": "texra.showMultiAgent",
        "title": "Agent Team Settings",
        "category": "TeXRA",
        "icon": "$(organization)"
      },
      {
        "command": "texra.showGitSettings",
        "title": "Git Settings",
        "category": "TeXRA",
        "icon": "$(git-branch)"
      },
      {
        "command": "texra.showMainView",
        "title": "New Task",
        "category": "TeXRA",
        "icon": "$(edit)"
      },
      {
        "command": "texra.showProgressView",
        "title": "Show Sessions",
        "category": "TeXRA",
        "icon": "$(eye)"
      },
      {
        "command": "texra.openProgressViewInTab",
        "title": "Open Sessions in Editor",
        "shortTitle": "Open in Editor",
        "category": "TeXRA",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "texra.showDashboard",
        "title": "Open Settings",
        "shortTitle": "Settings",
        "category": "TeXRA",
        "icon": "$(gear)"
      },
      {
        "command": "texra.replyComment",
        "title": "Reply",
        "category": "TeXRA"
      },
      {
        "command": "texra.resolveCommentThread",
        "title": "Resolve",
        "category": "TeXRA",
        "icon": "$(check)"
      },
      {
        "command": "texra.unresolveCommentThread",
        "title": "Reopen",
        "category": "TeXRA",
        "icon": "$(history)"
      }
    ],
    "walkthroughs": [
      {
        "id": "texra.gettingStarted",
        "title": "Get started with TeXRA",
        "description": "Connect a model, open your paper, let the setup assistant check your project, then run your first task.",
        "steps": [
          {
            "id": "texra.gettingStarted.signIn",
            "title": "Connect a model",
            "description": "TeXRA needs one way to reach a model. It is the one step no agent can do for you.\n\n**ChatGPT subscription**: Plus, Pro, and Team plans run Codex models through your ChatGPT sign-in.\n\n[Sign in with ChatGPT](command:texra.auth.chatgpt.signIn)\n\n**Your own API key**: Anthropic, OpenAI, Google, and more. Chat subscriptions other than ChatGPT do not include API access.\n\n[Set API key](command:texra.setApiKey)\n\nA TeXRA account is optional: it only adds the hosted remote agents. The bundled agents, the orchestrator included, work without one.",
            "media": {
              "image": "resources/walkthroughs/media/api-key-setup.png",
              "altText": "Screenshot of the provider API key settings"
            },
            "completionEvents": [
              "onCommand:texra.auth.chatgpt.signIn",
              "onCommand:texra.setApiKey"
            ]
          },
          {
            "id": "texra.gettingStarted.openPaper",
            "title": "Open your paper",
            "description": "TeXRA works inside one folder: the folder that holds your LaTeX project.\n\n[Open Folder](command:workbench.action.files.openFolder)\n\nNo project at hand? Start from the bundled sample, clone one from Overleaf, or download a paper's source from arXiv.\n\n[Create the sample project](command:texra.createSampleProject)\n\n[Clone from Overleaf](command:texra.walkthroughWorkspaceAction?%5B%22texra.cloneOverleafProject%22%5D)\n\n[Download from arXiv](command:texra.walkthroughWorkspaceAction?%5B%22texra.downloadArXivSource%22%5D)",
            "media": {
              "image": "resources/walkthroughs/media/file-selection.png",
              "altText": "Screenshot of a paper's files attached to a new task"
            },
            "completionEvents": [
              "onContext:workspaceFolderCount == 1",
              "onCommand:texra.createSampleProject",
              "onCommand:texra.cloneOverleafProject",
              "onCommand:texra.downloadArXivSource"
            ]
          },
          {
            "id": "texra.gettingStarted.setupAssistant",
            "title": "Run the setup assistant",
            "description": "One conversation covers the rest. The setup assistant checks your LaTeX tools and offers to install what is missing, asks what you are working on and applies a matching agent team, then runs a first polish on your paper that ends at a diff. It asks before every command it runs.\n\n[Run Setup Assistant](command:texra.walkthroughWorkspaceAction?%5B%22texra.runSetupAssistant%22%5D)",
            "media": {
              "image": "resources/walkthroughs/media/texra-progressboard.png",
              "altText": "Screenshot of a TeXRA session"
            },
            "completionEvents": [
              "onCommand:texra.runSetupAssistant"
            ]
          },
          {
            "id": "texra.gettingStarted.firstTask",
            "title": "Your first task",
            "description": "Open **New task** in the TeXRA panel, say what you want (for example, \"tighten the introduction\"), and send it. Pick **orchestrator** in the agent menu to have it plan the work and hand each part to the right agent.\n\n[New task](command:texra.walkthroughWorkspaceAction?%5B%22texra.showMainView%22%5D)\n\nEvery task becomes a session. The **Sessions** button at the top of the panel lists them, running or finished, so you can come back to one.\n\nBefore an agent edits a file or runs a command, it asks in the conversation, and edits open in VS Code's diff view so you see each change first. To change how often it asks, set the approval policy under Settings > Tools.\n\n[Approval settings](command:texra.walkthroughWorkspaceAction?%5B%22texra.showTools%22%5D)",
            "media": {
              "image": "resources/walkthroughs/media/vscode-compare.png",
              "altText": "Screenshot of the VS Code diff view"
            },
            "completionEvents": [
              "onCommand:texra.showMainView"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "texra",
          "title": "TeXRA",
          "icon": "resources/logo-128x128.svg"
        }
      ]
    },
    "views": {
      "texra": [
        {
          "type": "webview",
          "id": "texra.mainView",
          "name": "TeXRA",
          "contextualTitle": "TeXRA"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "when": "texra.activated && editorLangId == latex",
          "command": "texra.fixCompilation",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "texra.showDashboard",
          "when": "texra.activated && view == texra.mainView",
          "group": "navigation@0"
        }
      ],
      "commandPalette": [
        {
          "command": "texra.createSampleProject",
          "when": "texra.activated"
        },
        {
          "command": "texra.openGettingStarted",
          "when": "texra.activated"
        },
        {
          "command": "texra.runSetupAssistant",
          "when": "texra.activated"
        },
        {
          "command": "texra.cleanBuild",
          "when": "texra.activated"
        },
        {
          "command": "texra.cloneOverleafProject",
          "when": "texra.activated"
        },
        {
          "command": "texra.indentCurrentTeX",
          "when": "texra.activated"
        },
        {
          "command": "texra.fixCompilation",
          "when": "texra.activated"
        },
        {
          "command": "texra.getTeXCount",
          "when": "texra.activated"
        },
        {
          "command": "texra.extractTikzFigures",
          "when": "texra.activated"
        },
        {
          "command": "texra.compileTikzFigures",
          "when": "texra.activated"
        },
        {
          "command": "texra.downloadArXivSource",
          "when": "texra.activated"
        },
        {
          "command": "texra.execute",
          "when": "false"
        },
        {
          "command": "texra.createAgentWithAI",
          "when": "false"
        },
        {
          "command": "texra.setApiKey",
          "when": "texra.activated"
        },
        {
          "command": "texra.removeApiKey",
          "when": "false"
        },
        {
          "command": "texra.auth.signIn",
          "when": "texra.activated"
        },
        {
          "command": "texra.auth.chatgpt.signIn",
          "when": "texra.activated"
        },
        {
          "command": "texra.auth.signOut",
          "when": "false"
        },
        {
          "command": "texra.auth.viewProfile",
          "when": "false"
        },
        {
          "command": "texra.showMemory",
          "when": "false"
        },
        {
          "command": "texra.showModels",
          "when": "false"
        },
        {
          "command": "texra.showAgents",
          "when": "false"
        },
        {
          "command": "texra.showTools",
          "when": "false"
        },
        {
          "command": "texra.showMultiAgent",
          "when": "false"
        },
        {
          "command": "texra.showGitSettings",
          "when": "false"
        },
        {
          "command": "texra.showMainView",
          "when": "texra.activated"
        },
        {
          "command": "texra.showProgressView",
          "when": "texra.activated"
        },
        {
          "command": "texra.openProgressViewInTab",
          "when": "texra.activated"
        },
        {
          "command": "texra.showDashboard",
          "when": "texra.activated"
        },
        {
          "command": "texra.replyComment",
          "when": "false"
        },
        {
          "command": "texra.resolveCommentThread",
          "when": "false"
        },
        {
          "command": "texra.unresolveCommentThread",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "texra.replyComment",
          "group": "inline",
          "when": "commentController == texra.inlineComments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "texra.resolveCommentThread",
          "group": "inline@1",
          "when": "commentController == texra.inlineComments && commentThread == texraInlineCommentOpen"
        },
        {
          "command": "texra.unresolveCommentThread",
          "group": "inline@1",
          "when": "commentController == texra.inlineComments && commentThread == texraInlineCommentResolved"
        }
      ]
    },
