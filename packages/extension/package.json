  "private": false,
  "scripts": {
    "vscode:prepublish": "[ \"$SKIP_VSCE_PREPUBLISH\" = \"1\" ] || (corepack pnpm run prepare:docs && corepack pnpm run package:fast)",
    "clean:dist": "node ../../scripts/clean-extension-dist.mjs",
    "clean:webview-dist": "node ../../scripts/clean-extension-dist.mjs --webviews-only",
    "prepare:docs": "node ../../scripts/copy-extension-docs.mjs",
    "prepare:skills": "node ../../scripts/copy-extension-skills.mjs",
    "prepare:trace-viewer-assets": "corepack pnpm --filter @texra/trace-viewer run build",
    "esbuild:ext": "node esbuild.config.mjs",
    "esbuild:ext:watch": "node esbuild.config.mjs --watch",
    "esbuild:ext:prod": "node esbuild.config.mjs --production",
    "vite:webviews": "corepack pnpm run clean:webview-dist && for v in progressView settingsView webview; do VITE_WEBVIEW=$v vite build; done",
    "vite:webviews:dev": "corepack pnpm run clean:webview-dist && for v in progressView settingsView webview; do VITE_WEBVIEW=$v vite build --mode development; done",
    "vite:webviews:watch": "concurrently \"VITE_WEBVIEW=progressView vite build --watch --mode development\" \"VITE_WEBVIEW=settingsView vite build --watch --mode development\" \"VITE_WEBVIEW=webview vite build --watch --mode development\"",
    "compile:fast": "corepack pnpm run prepare:skills && corepack pnpm run clean:dist && concurrently \"corepack pnpm run prepare:trace-viewer-assets\" \"corepack pnpm run esbuild:ext\" \"corepack pnpm run vite:webviews:dev\"",
    "watch:fast": "echo \"[texra-watch] starting\" && corepack pnpm run compile:fast && echo \"[texra-watch] initial build complete\" && concurrently \"corepack pnpm run esbuild:ext:watch\" \"corepack pnpm run vite:webviews:watch\"",
    "package:fast": "corepack pnpm run prepare:skills && corepack pnpm run clean:dist && concurrently \"corepack pnpm run prepare:trace-viewer-assets\" \"corepack pnpm run esbuild:ext:prod\" \"corepack pnpm run vite:webviews\"",
    "build:fast": "corepack pnpm run package:fast && corepack pnpm run prepare:docs && mkdir -p ../../releases && SKIP_VSCE_PREPUBLISH=1 vsce package --no-dependencies --out ../../releases/texra-$npm_package_version.vsix"
  }
