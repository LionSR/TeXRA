{
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "vscode-jsonrpc/node": ["node_modules/vscode-jsonrpc/lib/node/main"],
      "@shared/*": ["src/shared/*"],
      "@common/state": ["packages/extension/src/common/state"],
      "@common/state/*": ["packages/extension/src/common/state/*"],
      "@common/webview": ["packages/extension/src/common/webview"],
      "@common/webview/*": ["packages/extension/src/common/webview/*"],
      "@common/*": ["src/common/*"],
      "@webview/*": ["packages/extension/src/webview/*"],
      "@agent/*": ["src/agent/*"],
      "@frontend/*": ["packages/extension/src/frontend/*"],
      "@hosts/*": ["src/hosts/*"],
      "@utils/*": ["src/utils/*"],
      "@logger": ["src/logger"],
      "@logger/*": ["src/logger/*"],
      "@telemetry": ["src/telemetry"],
      "@telemetry/*": ["src/telemetry/*"],
      "@transcript": ["src/transcript"],
      "@transcript/*": ["src/transcript/*"],
      "@latex/*": ["src/latex/*"],
      "@commands/*": ["packages/extension/src/commands/*"],
      "@resources/*": ["packages/extension/resources/*"],
      "@model": ["src/model"],
      "@model/*": ["src/model/*"],
      "@skills/*": ["src/skills/*"],
      "@housekeeping": ["src/housekeeping"],
      "@housekeeping/*": ["src/housekeeping/*"],
      "@progressView/*": ["packages/extension/src/progressView/*"],
      "@settingsView/*": ["packages/extension/src/settingsView/*"],
      "@extensionSchemas/*": ["packages/extension/src/schemas/*"],
      "@replacement/*": ["src/replacement/*"],
      "@tools/*": ["src/tools/*"],
      "@types/*": ["src/types/*"],
      "@eventBus/*": ["src/eventBus/*"],
      "@auth/*": ["src/auth/*"],
      "@platform/*": ["src/platform/*"],
      "turndown-plugin-gfm": ["src/types/ambient.d.ts"],
      "data-uri-to-buffer": ["node_modules/data-uri-to-buffer/dist/node.d.ts"],
      "@openrouter/sdk": ["node_modules/@openrouter/sdk/esm/index.d.ts"],
      "@openrouter/sdk/models": [
        "node_modules/@openrouter/sdk/esm/models/index.d.ts"
      ],
      "@openrouter/sdk/models/errors": [
        "node_modules/@openrouter/sdk/esm/models/errors/index.d.ts"
      ],
      "@controllers/*": ["src/controllers/*"],
      "@test/*": ["src/test-kernel/*"],
      "@cli/*": ["packages/cli/src/*"],
      "@desktop/*": ["packages/desktop/src/*"]
    }
  }
}
