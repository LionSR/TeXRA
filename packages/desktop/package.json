{
  "name": "@texra/desktop",
  "version": "0.41.0",
  "description": "TeXRA standalone desktop application",
  "author": "TeXRA.ai <contact@texra.ai>",
  "homepage": "https://texra.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/LionSR/TeXRA.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "watch:main": "node esbuild.main.mjs --watch",
    "typecheck": "tsc --noEmit --checkers 8 -p tsconfig.json && tsc --noEmit --checkers 8 -p tsconfig.main.json && tsc --noEmit --checkers 8 -p tsconfig.preload.json && tsc --noEmit --checkers 8 -p tsconfig.renderer.json && tsc --noEmit --checkers 8 -p tsconfig.tooling.json",
    "build:main": "node esbuild.main.mjs",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload/index.cjs --external:electron",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "corepack pnpm run typecheck && corepack pnpm run build:main && corepack pnpm run build:preload && corepack pnpm run build:renderer",
    "package:dir": "corepack pnpm exec electron-builder --dir --config electron-builder.yml",
    "package:dist": "corepack pnpm exec electron-builder --config electron-builder.yml --publish never",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lit-labs/signals": "^0.3.0",
    "@playwright/test": "^1.63.0",
    "@texra-ai/harness": "workspace:*",
    "@texra-ai/llm": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "effect": "catalog:",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "escape-string-regexp": "catalog:",
    "fix-path": "^5.0.0",
    "lit": "^3.3.3",
    "nanoid": "catalog:",
    "signal-polyfill": "^0.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
