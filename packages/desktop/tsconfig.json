{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2023"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@agent/*": ["src/agent/*"],
      "@auth/*": ["src/auth/*"],
      "@common/*": ["src/common/*"],
      "@eventBus/*": ["src/eventBus/*"],
      "@frontend/*": ["packages/extension/src/frontend/*"],
      "@housekeeping": ["src/housekeeping"],
      "@housekeeping/*": ["src/housekeeping/*"],
      "@latex": ["src/latex"],
      "@latex/*": ["src/latex/*"],
      "@logger/*": ["src/logger/*"],
      "@model": ["src/model"],
      "@model/*": ["src/model/*"],
      "@platform": ["src/platform"],
      "@platform/*": ["src/platform/*"],
      "@replacement/*": ["src/replacement/*"],
      "@shared/*": ["src/shared/*"],
      "@progressView/*": ["packages/extension/src/progressView/*"],
      "@settingsView/*": ["packages/extension/src/settingsView/*"],
      "@tools/*": ["src/tools/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@webview/*": ["packages/extension/src/webview/*"]
    }
  },
  "include": ["vite.config.ts"]
}
