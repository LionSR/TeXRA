{
  "name": "@texra-ai/llm",
  "version": "0.1.0",
  "type": "module",
  "description": "TeXRA-owned canonical model operations",
  "license": "Apache-2.0",
  "author": "TeXRA.ai",
  "homepage": "https://texra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LionSR/TeXRA.git",
    "directory": "packages/llm"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "NOTICE.txt"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/types/node.d.ts",
        "import": "./dist/node.js"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent ?? '')) { console.error('Pack and publish with pnpm: only it applies publishConfig.exports and resolves workspace: versions.'); process.exit(1); }\" && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test-live.json && node scripts/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@google/genai": "2.27.0",
    "@openrouter/sdk": "1.4.21",
    "llm-zoo": "catalog:",
    "openai": "7.20.0",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/ws": "8.18.2",
    "@typescript/native": "catalog:",
    "effect": "4.0.1",
    "esbuild": "catalog:",
    "vitest": "^5.0.3",
    "zod": "4.4.3"
  }
}
