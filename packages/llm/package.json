{
  "name": "@texra-ai/llm",
  "version": "0.1.0",
  "type": "module",
  "description": "One Effect contract over the OpenAI Responses, Anthropic Messages and Google Interactions wire protocols, with the llm-zoo model catalog",
  "keywords": [
    "llm",
    "effect",
    "openai",
    "anthropic",
    "gemini",
    "texra"
  ],
  "license": "Apache-2.0",
  "author": "TeXRA.ai",
  "homepage": "https://texra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LionSR/TeXRA.git",
    "directory": "packages/llm"
  },
  "bugs": {
    "url": "https://github.com/LionSR/TeXRA/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "NOTICE.txt"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/types/node.d.ts",
        "import": "./dist/node.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent ?? '')) { console.error('Pack and publish with pnpm: only it applies publishConfig.exports and resolves workspace: versions.'); process.exit(1); }\" && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test-live.json && node scripts/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@google/genai": "2.30.0",
    "llm-zoo": "catalog:",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/ws": "8.18.2",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "openai": "7.20.0",
    "vitest": "^5.0.5"
  }
}
