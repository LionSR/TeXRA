    "fast-xml-parser": "^5.10.0",
    "fastest-levenshtein": "^1.0.16",
    "fs-extra": "^11.3.6",
    "glob": "^13.0.6",
    "highlight.js": "^11.11.1",
    "highlightjs-lean": "^1.2.0",
    "http-status-codes": "^2.3.0",
    "identifiers-arxiv": "^0.1.1",
    "ignore": "^7.0.6",
