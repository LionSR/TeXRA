    "walkthroughs": [
      {
        "id": "texra.gettingStarted",
        "title": "Run your first TeXRA workflow",
        "description": "Complete this checklist to configure TeXRA, run your first agent, and review results without leaving VS Code.",
        "steps": [
          {
            "id": "texra.gettingStarted.sampleWorkspace",
            "title": "Seed the sample workspace",
            "description": "Start with the bundled workspace so you can experiment safely.\n[Create the sample project](command:texra.createSampleProject) and review the README that opens for links back to this checklist.",
            "media": {
              "markdown": "resources/walkthroughs/getting-started.md"
            },
            "completionEvents": [
              "onCommand:texra.createSampleProject"
            ]
          },
          {
            "id": "texra.gettingStarted.apiKeys",
            "title": "Connect your API keys",
            "description": "Register your Anthropic, OpenAI, Google, or other provider keys before running agents.\n[Set API keys](command:texra.setApiKey) and keep the defaults unless you need workspace-specific overrides.",
            "media": {
              "image": "resources/walkthroughs/media/api-key-setup.png",
              "altText": "Screenshot of the API key configuration view"
            },
            "completionEvents": [
              "onCommand:texra.setApiKey"
            ]
          },
          {
            "id": "texra.gettingStarted.stageFiles",
            "title": "Stage your files",
            "description": "Use the Input, Reference, Auxiliary, and Media pickers to tell TeXRA what to read.\n[Open the TeXRA main view](command:texra.showMainView) and choose whether you want a single output or multiple outputs for parallel drafts.",
            "media": {
              "image": "resources/walkthroughs/media/file-selection.png",
              "altText": "Screenshot of the file selection interface"
            },
            "completionEvents": [
              "onCommand:texra.showMainView"
            ]
          },
          {
            "id": "texra.gettingStarted.agentModel",
            "title": "Choose an agent and model",
            "description": "Match your task to the right persona—`correct` for structural fixes, `polish` for copy edits, or `draw` for diagrams—and pair it with a model tier that balances quality and speed.",
            "media": {
              "image": "resources/walkthroughs/media/agent-model-selection.png",
              "altText": "Screenshot of the agent and model selection UI"
            }
          },
          {
            "id": "texra.gettingStarted.autoExtract",
            "title": "Enable automatic figure extraction",
            "description": "Toggle **Auto-extract figures** and **Auto-extract TikZ blocks** before you run so TeXRA gathers assets for you. You can also try the standalone commands: [Extract figure paths](command:texra.extractFigurePaths) or [Extract TikZ figures](command:texra.extractTikzFigures).",
            "media": {
              "image": "resources/walkthroughs/media/auto-extract-options.png",
              "altText": "Screenshot showing auto-extraction options"
            },
            "completionEvents": [
              "onCommand:texra.extractFigurePaths",
              "onCommand:texra.extractTikzFigures"
            ]
          },
          {
            "id": "texra.gettingStarted.progress",
            "title": "Execute and watch progress",
            "description": "Kick off your run and watch logs, tool calls, and outputs stream into Progress.\n[Execute the agent](command:texra.execute) and keep an eye on [Show Progress](command:texra.showProgressView) for status updates.",
            "media": {
              "image": "resources/walkthroughs/media/texra-progressboard.png",
              "altText": "Screenshot of the Progress view"
            },
            "completionEvents": [
              "onCommand:texra.execute"
            ]
          },
          {
            "id": "texra.gettingStarted.review",
            "title": "Review and diff outputs",
            "description": "Open the generated files, compare them against your sources, and accept or iterate. Use VS Code's diff view to see every change before you commit.",
            "media": {
              "image": "resources/walkthroughs/media/vscode-compare.png",
              "altText": "Screenshot of the VS Code diff view"
            }
          },
          {
            "id": "texra.gettingStarted.housekeeping",
            "title": "Pack and clean up",
            "description": "After reviewing, use **Pack** $(archive) to archive outputs into a timestamped `History/` folder, or **Clean** $(trash) to delete generated files.\n\nFind these actions in:\n- The **Progress toolbar** on each completed run\n- The **editor title menu** (overflow `...`) when editing a `.tex` file\n- The **right-click context menu** on `.tex` files\n\nOr try the workspace-wide commands: [Clean all LLM outputs](command:texra.cleanOutput) | [Clean all build files](command:texra.cleanBuild)",
            "media": {
              "image": "resources/walkthroughs/media/texra-progressboard.png",
              "altText": "Screenshot showing pack and clean buttons in the Progress toolbar"
            },
            "completionEvents": [
              "onCommand:texra.cleanOutput",
              "onCommand:texra.cleanBuild",
              "onCommand:texra.pack",
              "onCommand:texra.clean"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "texra",
          "title": "TeXRA",
          "icon": "resources/logo-128x128.svg"
        }
      ]
    },
    "views": {
      "texra": [
        {
          "type": "webview",
          "id": "texra.mainView",
          "name": "TeXRA",
          "contextualTitle": "TeXRA"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.indentCurrentTeX",
          "group": "navigation"
        },
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.applyReplacements",
          "group": "navigation"
        },
        {
          "when": "editorLangId == latex",
          "command": "texra.fixCompilation",
          "group": "navigation"
        },
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.getTeXCount",
          "group": "navigation"
        },
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.cleanOutput",
          "group": "2_texra_housekeeping@1"
        },
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.cleanBuild",
          "group": "2_texra_housekeeping@2"
        }
      ],
      "view/title": [
        {
          "command": "texra.indentTeX",
          "when": "view == texra.mainView && texra.activeView == 'progress'",
          "group": "navigation@1"
        },
        {
          "command": "texra.cleanOutput",
          "when": "view == texra.mainView && texra.activeView == 'progress'",
          "group": "navigation@2"
        },
        {
          "command": "texra.cleanBuild",
          "when": "view == texra.mainView && texra.activeView == 'progress'",
          "group": "navigation@3"
        },
        {
          "command": "texra.showDashboard",
          "when": "view == texra.mainView && texra.activeView == 'progress'",
          "group": "navigation@4"
        },
        {
          "command": "texra.mainView.reset",
          "when": "view == texra.mainView && texra.activeView != 'progress'",
          "group": "navigation@0"
        },
        {
          "command": "texra.showDashboard",
          "when": "view == texra.mainView && texra.activeView != 'progress'",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.cleanOutput",
          "group": "z_texra@1"
        },
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.cleanBuild",
          "group": "z_texra@2"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.cleanOutput",
          "group": "z_texra@1"
        },
        {
          "when": "resourceLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.cleanBuild",
          "group": "z_texra@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "texra.showMainView",
        "key": "ctrl+alt+m",
        "mac": "cmd+option+m"
      },
      {
        "command": "texra.showProgressView",
        "key": "ctrl+alt+p",
        "mac": "cmd+option+p"
      },
      {
        "command": "texra.cleanOutput",
        "key": "ctrl+alt+shift+c",
        "mac": "cmd+option+shift+c"
      },
      {
        "command": "texra.cleanBuild",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+option+shift+b"
      },
      {
        "command": "texra.toggleView",
        "key": "ctrl+alt+t",
        "mac": "cmd+option+t",
        "when": "focusedView == texra.mainView"
      },
      {
        "command": "texra.execute",
        "key": "ctrl+alt+e",
        "mac": "cmd+option+e"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "[ \"$SKIP_VSCE_PREPUBLISH\" = \"1\" ] || npm run package",
    "compile": "NODE_OPTIONS=--max-old-space-size=8192 webpack",
    "watch": "NODE_OPTIONS=--max-old-space-size=8192 webpack --watch",
    "package": "NODE_OPTIONS=--max-old-space-size=8192 webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "npm run compile && vsce package --out releases/texra-$npm_package_version.vsix",
    "format": "prettier --write .",
    "esbuild:ext": "node esbuild.config.mjs",
    "esbuild:ext:watch": "node esbuild.config.mjs --watch",
    "esbuild:ext:prod": "node esbuild.config.mjs --production",
    "vite:webviews": "for v in progressView settingsView webview; do VITE_WEBVIEW=$v vite build; done",
    "vite:webviews:dev": "for v in progressView settingsView webview; do VITE_WEBVIEW=$v vite build --mode development; done",
    "vite:webviews:watch": "VITE_WEBVIEW=progressView vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "compile:fast": "npm run esbuild:ext && npm run vite:webviews:dev",
    "compile:safe": "npm run typecheck && npm run compile:fast",
    "watch:fast": "concurrently \"npm run esbuild:ext:watch\" \"npm run vite:webviews:watch\"",
    "package:fast": "npm run esbuild:ext:prod && npm run vite:webviews",
    "package:safe": "npm run typecheck && npm run package:fast",
    "build:fast": "npm run package:fast && SKIP_VSCE_PREPUBLISH=1 vsce package --out releases/texra-$npm_package_version.vsix",
    "build:safe": "npm run typecheck && npm run build:fast"
  },
