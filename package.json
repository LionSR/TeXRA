{
  "name": "texra",
  "displayName": "TeXRA",
  "description": "TeXRA: Your LLM-powered 24/7 LaTeX Research Assistant.",
  "version": "0.30.2",
  "publisher": "texra-ai",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "AI",
    "Education"
  ],
  "activationEvents": [
    "onView:texra",
    "onColorTheme"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "TeXRA",
        "properties": {
          "texra.agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "correct",
              "polish",
              "draw",
              "ocr",
              "paper2slide",
              "paper2poster",
              "transcribe_audio"
            ],
            "description": "List of available agents",
            "scope": "resource"
          },
          "texra.models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "sonnet37T",
              "sonnet37",
              "o3",
              "o4-",
              "o3-",
              "o1",
              "gpt41",
              "gpt4o",
              "gemini25p",
              "gemini25f",
              "gemini2fT",
              "DSV3",
              "DSR1",
              "grok3"
            ],
            "description": "List of available models",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Model Settings",
        "properties": {
          "texra.model.useOpenRouter": {
            "type": "boolean",
            "default": false,
            "description": "Whether to use OpenRouter for API calls when possible",
            "scope": "resource"
          },
          "texra.model.useStreaming": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming API responses when supported by the model. This serves as a global default but can be overridden by provider-specific settings.",
            "scope": "resource"
          },
          "texra.model.useStreamingAnthropic": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming for Anthropic models. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useStreamingOpenai": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming for OpenAI models. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useStreamingGoogle": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming for Google models via OpenAI-compatible API. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useStreamingXai": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming for xAI models via OpenAI-compatible API. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useStreamingDeepSeek": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming for DeepSeek models via OpenAI-compatible API. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useStreamingOpenrouter": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming for models accessed via OpenRouter. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useNativeGoogleSDK": {
            "type": "boolean",
            "default": false,
            "description": "Use the native @google/genai SDK for Google models instead of the OpenAI-compatible API. This feature is experimental and may not work as expected.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "File Handling",
        "properties": {
          "texra.files.included.mediaExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".png",
              ".pdf",
              ".jpeg",
              ".jpg",
              ".gif",
              ".heic",
              ".heif",
              ".webp",
              ".wav",
              ".m4a",
              ".mp3",
              ".aiff",
              ".aac",
              ".ogg",
              ".flac"
            ],
            "description": "File extensions to include when searching for figures",
            "editPresentation": "multilineText",
            "order": 4
          },
          "texra.files.included.inputExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md"
            ],
            "description": "File extensions to include when searching for input files",
            "editPresentation": "multilineText",
            "order": 5
          },
          "texra.files.included.referenceExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md"
            ],
            "description": "File extensions to include when searching for reference files",
            "editPresentation": "multilineText",
            "order": 6
          },
          "texra.files.included.auxiliaryExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".cls",
              ".md",
              ".sty"
            ],
            "description": "File extensions to include when searching for auxiliary files",
            "editPresentation": "multilineText",
            "order": 7
          },
          "texra.files.included.editedExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex"
            ],
            "description": "File extensions to include when searching for edited files",
            "editPresentation": "multilineText",
            "order": 8
          },
          "texra.files.ignored.fileExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".pdf",
              ".bst",
              ".bib",
              ".json",
              ".py",
              ".ipynb",
              ".png",
              ".vsix",
              ".ts",
              ".js",
              ".yaml"
            ],
            "description": "File extensions to ignore when listing text files",
            "editPresentation": "multilineText",
            "order": 9
          },
          "texra.files.ignored.inputFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "command.tex",
              "commands.tex",
              "preamble.tex"
            ],
            "description": "Files to ignore when listing input, sample, and edited files, but not auxiliary files",
            "editPresentation": "multilineText",
            "order": 10
          },
          "texra.files.ignored.auxiliaryKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "o1",
              "o3",
              "o4",
              "gpt",
              "sonnet",
              "haiku",
              "opus",
              "gemini",
              "grok",
              "deepseek",
              "llama",
              "egg-info"
            ],
            "description": "Additional keywords to ignore when listing auxiliary files, including model names",
            "editPresentation": "multilineText",
            "order": 11
          },
          "texra.files.ignored.mediaDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "versions",
              "history",
              "venv"
            ],
            "description": "Directories to ignore in the figure path",
            "editPresentation": "multilineText",
            "order": 12
          },
          "texra.files.ignored.directories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "figures",
              "media",
              "figs",
              "versions",
              "history",
              "stuff",
              "draft",
              "diff",
              "miscellaneous",
              "venv"
            ],
            "description": "Directories to ignore when listing files",
            "editPresentation": "multilineText",
            "order": 13
          },
          "texra.files.ignored.keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Makefile",
              "template",
              "_log",
              "_thinking",
              "_diff",
              "diff",
              "draw",
              "versions",
              "history",
              ".egg-info",
              "venv"
            ],
            "description": "Keywords to ignore when selecting files",
            "editPresentation": "multilineText",
            "order": 14
          }
        }
      },
      {
        "title": "LaTeX",
        "properties": {
          "texra.latex.latexindentConfig": {
            "type": "string",
            "default": "",
            "description": "Path to latexindent configuration file",
            "editPresentation": "singlelineText",
            "order": 1
          },
          "texra.latex.tikzInputDirectory": {
            "type": "string",
            "default": "",
            "description": "Directory where to look for extra input files when compiling extracted TikZ figures. Absolute path is required. Sets TEXINPUTS environment variable for TikZ compilation.",
            "editPresentation": "singlelineText",
            "order": 2
          },
          "texra.latex.tikzTemplate": {
            "type": "string",
            "default": "\\documentclass[tikz,border=10pt]{standalone}\n\\usepackage{tikz}\n\\usepackage{pgfplots}\n\\usetikzlibrary{positioning}\n\\usetikzlibrary{patterns}\n\\usetikzlibrary{arrows.meta, shapes.geometric, matrix, calc, decorations.pathreplacing}\n\\usetikzlibrary{shapes, arrows}\n\n\\begin{document}\n{{ tikzpicture }}\n\\end{document}",
            "description": "Template used for generating standalone documents when extracting and compiling TikZ figures",
            "editPresentation": "multilineText",
            "order": 3
          },
          "texra.latex.includeWorkspaceInTexinputs": {
            "type": "boolean",
            "default": true,
            "description": "Include the workspace root directory in TEXINPUTS when compiling TikZ figures",
            "order": 4
          },
          "texra.latex.enabledReplacements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "latex_spacing",
                "equations",
                "sections",
                "characters",
                "latex_xml",
                "unicode",
                "scratchpad_xml",
                "style",
                "personal_style",
                "max_style"
              ]
            },
            "default": [
              "latex_spacing",
              "equations",
              "sections",
              "characters",
              "latex_xml",
              "unicode",
              "scratchpad_xml",
              "style"
            ],
            "description": "List of enabled LaTeX replacement categories",
            "order": 5
          },
          "texra.latex.customReplacements": {
            "type": "object",
            "default": {},
            "description": "Custom LaTeX replacements in the format: { 'from': 'to' }. Example: { '\\alpha': '\\al' }",
            "additionalProperties": {
              "type": "string"
            },
            "order": 6
          }
        }
      },
      {
        "title": "Execution",
        "properties": {
          "texra.agent.pauseForConfirmation": {
            "type": "boolean",
            "default": false,
            "description": "Whether to pause for confirmation after each agent even with reflect=True",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Git",
        "properties": {
          "texra.git.numberOfCommitsToShow": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "description": "Number of recent commits to show in the commit selection dropdown",
            "order": 1
          }
        }
      },
      {
        "title": "Merge Operations",
        "properties": {
          "texra.merge.defaultModel": {
            "type": "string",
            "default": "sonnet37",
            "enum": [
              "sonnet37",
              "sonnet35",
              "gemini25p",
              "gemini2fT",
              "gemini2f",
              "gemini2p",
              "o3-mini",
              "gpt4o",
              "DSV3"
            ],
            "enumDescriptions": [
              "Claude Sonnet 3.7",
              "Claude Sonnet 3.5",
              "Gemini 2.5 Pro",
              "Gemini 2 Flash Thinking",
              "Gemini 2 Flash",
              "Gemini 2 Pro",
              "OpenAI O3 Mini",
              "OpenAI GPT-4O",
              "DeepSeek V3"
            ],
            "description": "Default model to use for merge operations",
            "order": 1
          },
          "texra.merge.defaultReflect": {
            "type": "string",
            "default": "False",
            "enum": [
              "True",
              "False"
            ],
            "description": "Default reflect setting for merge operations",
            "order": 2
          }
        }
      },
      {
        "title": "Code Validation & Fixing",
        "properties": {
          "texra.xmlValidator.maxIterations": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 20,
            "description": "Maximum number of iterations when trying to fix XML validation errors",
            "order": 2
          },
          "texra.linterFixer.maxIterations": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 20,
            "description": "Maximum number of iterations when trying to fix linter issues in code files",
            "order": 2
          },
          "texra.autoIterateOnLinter.latex": {
            "type": "boolean",
            "default": false,
            "description": "Automatically trigger LaTeX linter fix when linter issues are detected",
            "order": 3
          },
          "texra.autoIterateOnLinter.xml": {
            "type": "boolean",
            "default": false,
            "description": "Automatically trigger XML validation fix when XML validation issues are detected",
            "order": 4
          }
        }
      },
      {
        "title": "File Explorer",
        "properties": {
          "texra.explorer.agentsDirectory": {
            "type": "string",
            "default": "",
            "description": "Root path for the TeXRA file explorer view. Can be absolute or relative to workspace root.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "API Keys",
        "properties": {
          "texra.apiKeys.set": {
            "type": "null",
            "scope": "application",
            "markdownDescription": "API keys are now stored securely. [Click here to set an API key](command:texra.setApiKey)",
            "readOnly": true
          },
          "texra.apiKeys.remove": {
            "type": "null",
            "scope": "application",
            "markdownDescription": "API keys are now stored securely. [Click here to remove the stored key](command:texra.removeApiKey)",
            "readOnly": true
          }
        }
      },
      {
        "title": "Logger",
        "properties": {
          "texra.logger.verboseOutput": {
            "type": "boolean",
            "default": false,
            "description": "Whether to show verbose debug messages in the logger view",
            "scope": "resource"
          },
          "texra.debug.saveMessageObjects": {
            "type": "boolean",
            "default": false,
            "description": "Save message JSON objects to files before API calls for debugging purposes",
            "scope": "resource"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "texra.cleanOutput",
        "title": "Clean All LLM Output Files",
        "category": "TeXRA",
        "icon": "$(trash)"
      },
      {
        "command": "texra.cleanBuild",
        "title": "Clean All Build Files",
        "category": "TeXRA",
        "icon": "$(remove)"
      },
      {
        "command": "texra.indentTeX",
        "title": "Indent All LaTeX Files",
        "category": "TeXRA",
        "icon": "$(indent)"
      },
      {
        "command": "texra.getRecentCommits",
        "title": "Get Recent Commits",
        "category": "TeXRA"
      },
      {
        "command": "texra.refreshCommits",
        "title": "Refresh Commits",
        "category": "TeXRA"
      },
      {
        "command": "texra.indentCurrentTeX",
        "title": "Indent Current TeX",
        "category": "TeXRA",
        "icon": "$(indent)",
        "enablement": "!virtualWorkspace"
      },
      {
        "command": "texra.countPdfPages",
        "title": "Count PDF Pages",
        "category": "TeXRA"
      },
      {
        "command": "texra.encodeImageToBase64",
        "title": "Encode Image to Base64",
        "category": "TeXRA"
      },
      {
        "command": "texra.convertPdfToImages",
        "title": "Convert PDF to Images",
        "category": "TeXRA"
      },
      {
        "command": "texra.testPdfToImage",
        "title": "Test PDF to Image Conversion",
        "category": "TeXRA"
      },
      {
        "command": "texra.extractFigurePaths",
        "title": "Extract Figure Paths from LaTeX",
        "category": "TeXRA"
      },
      {
        "command": "texra.extractTikzFigures",
        "title": "Extract TikZ Figures from Current File",
        "category": "TeXRA"
      },
      {
        "command": "texra.compileTikzFigures",
        "title": "Compile TikZ Figures from Current File",
        "category": "TeXRA"
      },
      {
        "command": "texra.getTeXCount",
        "title": "Count Words in Current TeX File",
        "category": "TeXRA",
        "icon": "$(symbol-number)",
        "enablement": "!virtualWorkspace"
      },
      {
        "command": "texra.testConnection",
        "title": "Test Text Connection Methods",
        "category": "TeXRA"
      },
      {
        "command": "texra.testAgentLoading",
        "title": "Test Agent Loading",
        "category": "TeXRA"
      },
      {
        "command": "texra.loadSpecificAgent",
        "title": "Load Specific Agent",
        "category": "TeXRA"
      },
      {
        "command": "texra.downloadArXivSource",
        "title": "Download arXiv Source",
        "category": "TeXRA"
      },
      {
        "command": "texra.parseXml",
        "title": "Parse XML Structure",
        "category": "TeXRA"
      },
      {
        "command": "texra.validateAndFixXml",
        "title": "Validate and Fix XML using Claude",
        "category": "TeXRA"
      },
      {
        "command": "texra.parseYaml",
        "title": "Parse YAML Structure",
        "category": "TeXRA"
      },
      {
        "command": "texra.testYamlBrackets",
        "title": "Test YAML Bracket Handling",
        "category": "TeXRA"
      },
      {
        "command": "texra.stopAgent",
        "title": "Stop Agent",
        "category": "TeXRA"
      },
      {
        "command": "texra.execute",
        "title": "Execute Agent",
        "category": "TeXRA"
      },
      {
        "command": "texra.pack",
        "title": "Pack Files",
        "category": "TeXRA"
      },
      {
        "command": "texra.clean",
        "title": "Clean Files",
        "category": "TeXRA"
      },
      {
        "command": "texra.folderExplorer.newFile",
        "title": "New File",
        "category": "TeXRA",
        "icon": "$(new-file)"
      },
      {
        "command": "texra.folderExplorer.newFolder",
        "title": "New Folder",
        "category": "TeXRA",
        "icon": "$(new-folder)"
      },
      {
        "command": "texra.folderExplorer.rename",
        "title": "Rename",
        "category": "TeXRA",
        "icon": "$(edit)"
      },
      {
        "command": "texra.folderExplorer.delete",
        "title": "Delete",
        "category": "TeXRA",
        "icon": "$(trash)"
      },
      {
        "command": "texra.setApiKey",
        "title": "Set API Key",
        "category": "TeXRA"
      },
      {
        "command": "texra.removeApiKey",
        "title": "Remove API Key",
        "category": "TeXRA"
      },
      {
        "command": "texra.testTextEditor",
        "title": "Test Text Editor Tool",
        "category": "TeXRA",
        "icon": "$(edit)"
      },
      {
        "command": "texra.showLinterMessages",
        "title": "Show Linter Messages",
        "category": "TeXRA"
      },
      {
        "command": "texra.countLinterMessages",
        "title": "Count Linter Messages",
        "category": "TeXRA"
      },
      {
        "command": "texra.fixLinterIssues",
        "title": "Fix Linter Issues with Claude",
        "category": "TeXRA",
        "icon": "$(fix-all)"
      },
      {
        "command": "texra.testWolframAlpha",
        "title": "Test Wolfram Alpha API Connection",
        "category": "TeXRA"
      },
      {
        "command": "texra.wolframAlphaQuery",
        "title": "Query Wolfram Alpha",
        "category": "TeXRA"
      },
      {
        "command": "texra.testWolframScript",
        "title": "Test Wolfram Script Installation",
        "category": "TeXRA"
      },
      {
        "command": "texra.wolframScriptExecute",
        "title": "Execute Wolfram Language Code",
        "category": "TeXRA"
      },
      {
        "command": "texra.wolframScriptRunFile",
        "title": "Run Current Wolfram Language File",
        "category": "TeXRA"
      },
      {
        "command": "texra.showAgentHistory",
        "title": "Show Agent Execution History",
        "category": "TeXRA"
      },
      {
        "command": "texra.showProgressView",
        "title": "Show Tasks",
        "category": "TeXRA",
        "icon": "$(eye)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "texra",
          "title": "TeXRA",
          "icon": "resources/logo-128x128.svg"
        }
      ],
      "panel": [
        {
          "id": "texra-panel",
          "title": "TeXRA ProgressBoard",
          "icon": "$(server-process)"
        }
      ]
    },
    "views": {
      "texra": [
        {
          "type": "webview",
          "id": "texra.mainView",
          "name": "Your Favourite TeXRA",
          "contextualTitle": "TeXRA"
        },
        {
          "id": "texra.folderExplorer",
          "name": "TeX Agents",
          "when": "workbenchState != empty"
        }
      ],
      "texra-panel": [
        {
          "type": "webview",
          "id": "texra.progressView",
          "name": "TeXRA: ProgressBoard",
          "contextualTitle": "ProgressBoard",
          "icon": "$(server-process)"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.indentCurrentTeX",
          "group": "navigation"
        },
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "texra.getTeXCount",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "texra.indentTeX",
          "when": "view == texra.progressView",
          "group": "navigation@1"
        },
        {
          "command": "texra.cleanOutput",
          "when": "view == texra.progressView",
          "group": "navigation@2"
        },
        {
          "command": "texra.cleanBuild",
          "when": "view == texra.progressView",
          "group": "navigation@3"
        },
        {
          "command": "texra.folderExplorer.newFile",
          "when": "view == texra.folderExplorer",
          "group": "navigation"
        },
        {
          "command": "texra.folderExplorer.newFolder",
          "when": "view == texra.folderExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "texra.folderExplorer.newFile",
          "when": "view == texra.folderExplorer && viewItem == folder",
          "group": "1_modification"
        },
        {
          "command": "texra.folderExplorer.newFolder",
          "when": "view == texra.folderExplorer && viewItem == folder",
          "group": "1_modification"
        },
        {
          "command": "texra.folderExplorer.rename",
          "when": "view == texra.folderExplorer && viewItem != editing",
          "group": "2_modification"
        },
        {
          "command": "texra.folderExplorer.delete",
          "when": "view == texra.folderExplorer && viewItem != editing",
          "group": "3_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
