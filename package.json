    "markdown-it-texmath": "^1.0.0",
    "micromatch": "^4.0.8",
    "mime-types": "^3.0.1",
    "minimatch": "^10.2.5",
    "monaco-editor": "^0.55.1",
    "mutative": "^1.3.0",
