{
  "name": "texra-workspace",
  "version": "0.41.0",
  "private": true,
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint packages src",
    "test": "vitest run --config vitest.config.mjs",
    "test:changed": "vitest run --config vitest.config.mjs --changed --exclude '**/crashConformance*.vitest.ts'",
    "test:pure": "vitest run --config vitest.config.mjs --project pure",
    "test:live": "vitest run --config packages/llm/vitest.live.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs --exclude '**/crashConformance*.vitest.ts'",
    "desktop:build": "corepack pnpm --filter @texra/trace-viewer run build && corepack pnpm --filter @texra/desktop build && node packages/extension/scripts/build-serve.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gate": "npm run gate:invariants && npm run gate:docs && npm run gate:typecheck",
    "gate:docs": "node scripts/check-guidance-refs.mjs && node scripts/check-proposal-status.mjs && node docs/scripts/check-root-docs.mjs",
    "gate:invariants": "npm run lint && node scripts/check-row-kinds-ever.mjs && node scripts/check-api-report.mjs && npm run check:fact-spread && node scripts/verify-extension-package-invariants.mjs && node scripts/sync-package-contributes.mjs --check && node scripts/sync-notice-files.mjs --check",
    "gate:typecheck": "corepack pnpm --filter @texra-ai/cli smoke:react-compiler && npm run format:check && npm run typecheck",
    "test:vscode": "node scripts/vscode-host-e2e-runner.mjs",
    "typecheck": "corepack pnpm run --parallel --include-workspace-root \"/^typecheck:/\"",
    "typecheck:root": "tsc --noEmit --checkers 8",
    "typecheck:test-kernel": "tsc --noEmit --checkers 8 -p tsconfig.test-kernel.json",
    "typecheck:packages": "corepack pnpm -r --parallel run typecheck",
    "compile:fast": "corepack pnpm --filter texra compile:fast",
    "watch:fast": "corepack pnpm --filter texra watch:fast",
    "package:fast": "corepack pnpm --filter texra package:fast",
    "build:fast": "corepack pnpm --filter texra build:fast",
    "sync:package-contributes": "node scripts/sync-package-contributes.mjs",
    "check:fact-spread": "node scripts/check-fact-spread.mjs",
    "report:fix-churn": "node scripts/report-fix-churn.mjs",
    "docgen": "node scripts/check-api-report.mjs --write",
    "texra-local:build": "corepack pnpm --filter @texra-ai/cli run prepare:trace-viewer-assets && corepack pnpm --filter @texra-ai/cli run bundle && corepack pnpm --filter @texra-ai/cli run copy:resources && corepack pnpm --filter @texra-ai/cli run copy:docs",
    "texra-local:link": "node scripts/link-texra-local.mjs",
    "sync:notice": "node scripts/sync-notice-files.mjs",
    "storage:freeze": "vitest run --config vitest.config.mjs --mode freeze src/test-kernel/schemas/rowVersions.vitest.ts"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@electron/asar": "^4.3.1",
    "@jitl/quickjs-wasmfile-release-sync": "catalog:",
    "@lit-labs/signals": "^0.3.0",
    "@texra-ai/llm": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/vscode": "^1.125.0",
    "@typescript/native": "catalog:",
    "@vscode/test-electron": "^3.1.0",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "glob": "catalog:",
    "jsdom": "^30.1.3",
    "openai": "catalog:",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tar": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "catalog:"
  }
}
