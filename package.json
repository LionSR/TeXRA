{
  "name": "texra-workspace",
  "version": "0.37.8",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "vscode:prepublish": "[ \"$SKIP_VSCE_PREPUBLISH\" = \"1\" ] || npm run package",
    "compile": "corepack pnpm --filter texra compile",
    "watch": "corepack pnpm --filter texra watch",
    "package": "corepack pnpm --filter texra package",
    "compile-tests": "tsc -p tsconfig.json --outDir out",
    "watch-tests": "tsc -p tsconfig.json -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src packages/extension/src",
    "test": "vscode-test",
    "test:kernel": "vitest run --config vitest.config.mjs",
    "test:kernel:watch": "vitest --config vitest.config.mjs",
    "workspace:typecheck": "corepack pnpm --recursive --if-present typecheck",
    "workspace:build": "corepack pnpm --recursive --if-present build",
    "desktop:build": "corepack pnpm --filter @texra/desktop build",
    "build:initial": "corepack pnpm run desktop:build && corepack pnpm run build:fast && corepack pnpm run check:initial-build-artifacts",
    "build": "corepack pnpm --filter texra build:fast",
    "format": "prettier --write .",
    "esbuild:ext": "corepack pnpm --filter texra esbuild:ext",
    "esbuild:ext:watch": "corepack pnpm --filter texra esbuild:ext:watch",
    "esbuild:ext:prod": "corepack pnpm --filter texra esbuild:ext:prod",
    "vite:webviews": "corepack pnpm --filter texra vite:webviews",
    "vite:webviews:dev": "corepack pnpm --filter texra vite:webviews:dev",
    "vite:webviews:watch": "corepack pnpm --filter texra vite:webviews:watch",
    "typecheck": "tsc --noEmit && corepack pnpm --filter texra typecheck",
    "compile:fast": "corepack pnpm --filter texra compile:fast",
    "compile:safe": "npm run typecheck && npm run compile:fast",
    "watch:fast": "corepack pnpm --filter texra watch:fast",
    "package:fast": "corepack pnpm --filter texra package:fast",
    "package:safe": "npm run typecheck && npm run package:fast",
    "build:fast": "corepack pnpm --filter texra build:fast",
    "build:safe": "npm run typecheck && npm run build:fast",
    "sync:settings-configuration": "npm run compile-tests && node scripts/sync-settings-configuration.mjs",
    "check:settings-configuration": "npm run compile-tests && node scripts/sync-settings-configuration.mjs --check",
    "sync:extension-package-invariants": "node scripts/verify-extension-package-invariants.mjs --update",
    "check:extension-package-invariants": "node scripts/verify-extension-package-invariants.mjs",
    "check:vsix-contents": "node scripts/verify-vsix-contents.mjs",
    "check:initial-build-artifacts": "corepack pnpm run check:vsix-contents && node scripts/verify-desktop-build-artifacts.mjs",
    "sync:remote-agents": "node scripts/sync-remote-agents.mjs -o docs/supabase/SYNC_REFERENCE_AGENTS.sql",
    "check:remote-agents": "node scripts/sync-remote-agents.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/fs-extra": "^11.0.4",
    "@types/he": "^1.2.3",
    "@types/identifiers-arxiv": "^0.1.2",
    "@types/jsdom": "^28.0.1",
    "@types/mime-types": "^3.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/nunjucks": "^3.2.6",
    "@types/shell-quote": "^1.7.5",
    "@types/sortablejs": "^1.15.9",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.4",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "node-loader": "^2.1.0",
    "nunjucks": "^3.2.4",
    "path-browserify": "^1.0.1",
    "prettier": "^3.8.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.5.0",
    "ts-loader": "^9.5.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vscode-languageserver-protocol": "^3.17.5",
    "webpack": "^5.106.1",
    "webpack-cli": "^7.0.2",
    "zod-v3-to-v4": "^1.21.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@cantoo/pdf-lib": "^2.6.5",
    "@google/genai": "^1.51.0",
    "@jamesgopsill/crossref-client": "^1.1.0",
    "@lit-labs/signals": "^0.2.0",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.128.0",
    "@openrouter/sdk": "^0.12.23",
    "@supabase/supabase-js": "^2.105.1",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "arxiv-client": "^0.0.9",
    "axios": "^1.15.2",
    "bibtex": "^0.9.0",
    "deepmerge": "^4.3.1",
    "delay": "^7.0.0",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "fast-json-stable-stringify": "^2.1.0",
    "fast-xml-parser": "^5.7.2",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.6",
    "he": "^1.2.0",
    "highlight.js": "^11.11.1",
    "highlightjs-lean": "^1.2.0",
    "http-status-codes": "^2.3.0",
    "identifiers-arxiv": "^0.1.1",
    "katex": "^0.16.45",
    "lit": "^3.3.2",
    "llm-zoo": "^1.6.1",
    "mark.js": "^8.11.1",
    "markdown-it": "^14.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mime-types": "^3.0.1",
    "minimatch": "^10.2.5",
    "mutative": "^1.3.0",
    "nanoid": "^5.1.11",
    "node-pandoc": "^0.3.0",
    "openai": "^6.35.0",
    "p-map": "^7.0.4",
    "pdf2pic": "^3.2.0",
    "perfect-debounce": "^2.1.0",
    "postal-mime": "^2.7.4",
    "shell-quote": "^1.8.3",
    "signal-polyfill": "^0.2.2",
    "sortablejs": "^1.15.7",
    "strip-ansi": "^7.2.0",
    "tar": "^7.5.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.8.3",
    "zod": "^4.4.1"
  }
}
