{
  "name": "texra",
  "displayName": "TeXRA",
  "description": "TeXRA: Your LLM-powered 24/7 LaTeX Research Assistant.",
  "version": "0.33.8",
  "publisher": "texra-ai",
  "engines": {
    "vscode": "^1.99.3"
  },
  "categories": [
    "Programming Languages",
    "Chat",
    "Machine Learning",
    "Linters",
    "Formatters",
    "AI",
    "Education",
    "Data Science"
  ],
  "activationEvents": [
    "onView:texra.mainView",
    "onView:texra.folderExplorer",
    "onView:texra.progressView",
    "onColorTheme",
    "onCommand:texra.createSampleProject"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "TeXRA",
        "properties": {
          "texra.agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "chat",
              "ask",
              "correct",
              "polish",
              "draw",
              "ocr",
              "paper2slide",
              "paper2poster",
              "transcribe_audio"
            ],
            "description": "List of available agents",
            "scope": "resource"
          },
          "texra.includeToolUseAgents": {
            "type": "boolean",
            "default": false,
            "description": "Include built-in tool-use agents (e.g., xml_validator, tex_linter_fix) in the agent list",
            "scope": "resource"
          },
          "texra.models": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "opus41T",
                "opus41",
                "opus4T",
                "opus4",
                "sonnet4T",
                "sonnet4",
                "sonnet37T",
                "sonnet37",
                "o3pro",
                "o3",
                "o4-",
                "o3-",
                "o1pro",
                "o1",
                "gptoss",
                "gptoss-",
                "gpt45",
                "gpt5",
                "gpt5-",
                "gpt5--",
                "gpt41",
                "gpt4o",
                "gemini25p",
                "gemini25f",
                "deepseek",
                "deepseekT",
                "dsv3",
                "dsr1",
                "grok4",
                "grok3",
                "qwen3max",
                "qwenplus",
                "qwenturbo",
                "kimit",
                "kimiv",
                "kimi2",
                "kimi2turbo"
              ]
            },
            "default": [
              "gemini25p",
              "gemini25f",
              "opus41T",
              "sonnet4T",
              "gpt5",
              "gpt41",
              "deepseek",
              "deepseekT",
              "kimi2",
              "qwen3max",
              "grok4"
            ],
            "description": "List of available models. Model codes: opus41T/opus41 (Claude Opus 4.1 Thinking/Regular), opus4T/opus4 (Claude Opus 4 Thinking/Regular), sonnet4T/sonnet4 (Claude Sonnet 4 Thinking/Regular), sonnet37T/sonnet37 (Claude Sonnet 3.7 Thinking/Regular), o4-/o3/o3pro/o3-/o1pro/o1/gptoss/gptoss- (OpenAI reasoning models), gpt5/gpt5-/gpt5--/gpt41/gpt4o (GPT-5/5 Mini/5 Nano/4.1/4O), gemini25p/gemini25f/gemini2fT (Gemini 2.5 Pro/Flash, 2.0 Flash Thinking), deepseek/deepseekT(DeepSeek V3.1 Regular/Thinking), dsv3/dsr1 (DeepSeek V3/R1), grok4 (Grok 4), grok3 (Grok 3), qwen3max (Qwen-Max latest), qwenplus (Qwen Plus latest), qwenturbo (Qwen Turbo), kimit/kimiv/kimi2/kimi2turbo (Kimi Thinking/Vision/K2/K2 Turbo)",
            "scope": "resource"
          }
        }
      },
      {
        "title": "User Interface",
        "properties": {
          "texra.ui.showApiKeyReminders": {
            "type": "boolean",
            "default": true,
            "description": "Show API key reminders in the status bar and main view when no API keys are configured",
            "scope": "resource"
          },
          "texra.ui.showDependencyReminders": {
            "type": "boolean",
            "default": true,
            "description": "Show dependency check reminders in the main view when core dependencies are missing",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Model Settings",
        "properties": {
          "texra.model.useOpenRouter": {
            "type": "boolean",
            "default": false,
            "description": "Whether to use OpenRouter for API calls when possible",
            "scope": "resource"
          },
          "texra.model.useImprovedConnection": {
            "type": "boolean",
            "default": false,
            "description": "Use improved connection for API requests",
            "scope": "resource"
          },
          "texra.model.improvedConnectionDomain": {
            "type": "string",
            "description": "Domain to use when using improved connection",
            "default": "proxy.texra.ai",
            "scope": "resource"
          },
          "texra.model.useStreaming": {
            "type": "boolean",
            "default": true,
            "description": "Enable streaming API responses when supported by the model. This serves as a global default but can be overridden by provider-specific settings.",
            "scope": "resource"
          },
          "texra.model.useStreamingAnthropic": {
            "type": "boolean",
            "default": true,
            "description": "Enable streaming for Anthropic models. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useStreamingOpenai": {
            "type": "boolean",
            "default": true,
            "description": "Enable streaming for OpenAI models. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useStreamingGoogle": {
            "type": "boolean",
            "default": true,
            "description": "Enable streaming for Google models. Works with both the OpenAI-compatible API and the native GenAI SDK. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useStreamingXai": {
            "type": "boolean",
            "default": true,
            "description": "Enable streaming for xAI models via OpenAI-compatible API. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useStreamingDeepseek": {
            "type": "boolean",
            "default": true,
            "description": "Enable streaming for DeepSeek models via OpenAI-compatible API. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.baseUrlDeepSeek": {
            "type": "string",
            "default": "",
            "description": "Custom base URL for DeepSeek models; leave blank to use `https://api.deepseek.com`.",
            "scope": "resource"
          },
          "texra.model.useStreamingOpenrouter": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming for models accessed via OpenRouter. Overrides the global useStreaming setting.",
            "scope": "resource"
          },
          "texra.model.useOpenAIResponsesAPI": {
            "type": "boolean",
            "default": true,
            "description": "Use the OpenAI Responses API instead of the Chat Completions API when available.",
            "scope": "resource"
          },
          "texra.model.gpt5ReasoningSummary": {
            "type": "boolean",
            "default": false,
            "description": "Request reasoning summaries from GPT-5 models (requires verified account and appropriate user tier).",
            "scope": "resource"
          },
          "texra.model.useNativeGoogleSDK": {
            "type": "boolean",
            "default": true,
            "description": "Use the native @google/genai SDK for Google models instead of the OpenAI-compatible API. This feature is experimental and may not work as expected.",
            "scope": "resource"
          },
          "texra.model.useAnthropic1MBeta": {
            "type": "boolean",
            "default": false,
            "description": "Attach the `context-1m-2025-08-07` beta header for Claude Sonnet 4 requests to enable the 1M-token context window (usage capped at 200 K by extension).",
            "scope": "resource"
          },
          "texra.model.useCopilot": {
            "type": "boolean",
            "default": false,
            "description": "Use the Copilot language model via VS Code's Language Model API for polishing instructions and best connection detection.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "File Handling",
        "properties": {
          "texra.files.included.mediaExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".png",
              ".pdf",
              ".jpeg",
              ".jpg",
              ".gif",
              ".heic",
              ".heif",
              ".webp",
              ".wav",
              ".m4a",
              ".mp3",
              ".aiff",
              ".aac",
              ".ogg",
              ".flac"
            ],
            "description": "File extensions to include when searching for figures",
            "editPresentation": "multilineText",
            "order": 4
          },
          "texra.files.included.inputExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md"
            ],
            "description": "File extensions to include when searching for input files",
            "editPresentation": "multilineText",
            "order": 5
          },
          "texra.files.included.referenceExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md",
              ".bbl"
            ],
            "description": "File extensions to include when searching for reference files",
            "editPresentation": "multilineText",
            "order": 6
          },
          "texra.files.included.auxiliaryExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".cls",
              ".md",
              ".sty"
            ],
            "description": "File extensions to include when searching for auxiliary files",
            "editPresentation": "multilineText",
            "order": 7
          },
          "texra.files.included.editedExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex"
            ],
            "description": "File extensions to include when searching for edited files",
            "editPresentation": "multilineText",
            "order": 8
          },
          "texra.files.ignored.fileExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".pdf",
              ".bst",
              ".bib",
              ".json",
              ".py",
              ".ipynb",
              ".png",
              ".vsix",
              ".ts",
              ".js",
              ".yaml"
            ],
            "description": "File extensions to ignore when listing text files",
            "editPresentation": "multilineText",
            "order": 9
          },
          "texra.files.ignored.inputFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "command.tex",
              "commands.tex",
              "preamble.tex",
              "yaml"
            ],
            "description": "Files to ignore when listing input, sample, and edited files, but not auxiliary files",
            "editPresentation": "multilineText",
            "order": 10
          },
          "texra.files.ignored.inputDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "PapersEx"
            ],
            "description": "Additional directories to ignore when listing input and edited files",
            "editPresentation": "multilineText",
            "order": 11
          },
          "texra.files.ignored.auxiliaryKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "o1",
              "o3",
              "o4",
              "gpt",
              "sonnet",
              "haiku",
              "opus",
              "gemini",
              "grok",
              "deepseek",
              "qwen",
              "kimi",
              "llama",
              "egg-info",
              "yaml"
            ],
            "description": "Additional keywords to ignore when listing auxiliary files, including model names",
            "editPresentation": "multilineText",
            "order": 12
          },
          "texra.files.ignored.mediaDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "versions",
              "history",
              "venv",
              "Diffs"
            ],
            "description": "Directories to ignore in the figure path",
            "editPresentation": "multilineText",
            "order": 13
          },
          "texra.files.ignored.directories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "figures",
              "media",
              "figs",
              "versions",
              "history",
              "stuff",
              "draft",
              "miscellaneous",
              "diffs",
              "venv"
            ],
            "description": "Directories to ignore when listing files",
            "editPresentation": "multilineText",
            "order": 14
          },
          "texra.files.ignored.keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Makefile",
              "template",
              "_log",
              "_thinking",
              "_diff",
              "draw",
              "versions",
              "history",
              ".egg-info",
              "venv",
              "yaml"
            ],
            "description": "Keywords to ignore when selecting files",
            "editPresentation": "multilineText",
            "order": 15
          },
          "texra.maxImageDimension": {
            "type": "number",
            "default": 2000,
            "minimum": 100,
            "maximum": 10000,
            "description": "Maximum dimension (width or height) in pixels for images before resizing. Images larger than this will be resized to fit within this dimension while maintaining aspect ratio.",
            "order": 16
          }
        }
      },
      {
        "title": "LaTeX",
        "properties": {}
      },
      {
        "title": "LaTeX Formatter",
        "properties": {
          "texra.latex.formatter": {
            "type": "string",
            "enum": [
              "latexindent",
              "tex-fmt",
              "none"
            ],
            "default": "latexindent",
            "description": "LaTeX formatter to use when formatting files ('none' to disable)",
            "order": 1
          },
          "texra.latex.showLatexindentWarning": {
            "type": "boolean",
            "default": true,
            "description": "Show warning when latexindent is not installed",
            "order": 2
          },
          "texra.latex.latexindentConfig": {
            "type": "string",
            "default": "",
            "description": "Path to latexindent configuration file",
            "editPresentation": "singlelineText",
            "order": 3
          },
          "texra.latex.texfmtConfig": {
            "type": "string",
            "default": "",
            "description": "Path to tex-fmt configuration file",
            "editPresentation": "singlelineText",
            "order": 4
          }
        }
      },
      {
        "title": "TikZ Figures",
        "properties": {
          "texra.latex.tikzInputDirectory": {
            "type": "string",
            "default": "",
            "description": "Directory where to look for extra input files when compiling extracted TikZ figures. Absolute path is required. Sets TEXINPUTS environment variable for TikZ compilation.",
            "editPresentation": "singlelineText",
            "order": 4
          },
          "texra.latex.tikzTemplate": {
            "type": "string",
            "default": "\\documentclass[tikz,border=10pt]{standalone}\n\\usepackage{tikz}\n\\usepackage{pgfplots}\n\\usetikzlibrary{positioning}\n\\usetikzlibrary{patterns}\n\\usetikzlibrary{arrows.meta, shapes.geometric, matrix, calc, decorations.pathreplacing}\n\\usetikzlibrary{shapes, arrows}\n\n\\begin{document}\n{{ tikzpicture }}\n\\end{document}",
            "description": "Template used for generating standalone documents when extracting and compiling TikZ figures",
            "editPresentation": "multilineText",
            "order": 5
          },
          "texra.latex.includeWorkspaceInTexinputs": {
            "type": "boolean",
            "default": true,
            "description": "Include the workspace root directory in TEXINPUTS when compiling TikZ figures",
            "order": 6
          }
        }
      },
      {
        "title": "LaTeX Replacements",
        "properties": {
          "texra.latex.enabledReplacements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "latex_spacing",
                "equations",
                "sections",
                "characters",
                "latex_xml",
                "latex_document",
                "unicode",
                "scratchpad_xml",
                "latexdiff",
                "gptness",
                "personal_style",
                "max_style"
              ]
            },
            "default": [
              "latex_spacing",
              "equations",
              "sections",
              "characters",
              "latex_xml",
              "latex_document",
              "unicode",
              "scratchpad_xml",
              "latexdiff",
              "gptness"
            ],
            "description": "List of enabled non-regex LaTeX replacement categories",
            "order": 8
          },
          "texra.latex.enabledReplacementsRegex": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "inline_math",
                "parentheses",
                "latexdiff_markup",
                "equation_style",
                "max_style_regex"
              ]
            },
            "default": [
              "inline_math",
              "parentheses",
              "latexdiff_markup",
              "equation_style"
            ],
            "description": "List of enabled regex LaTeX replacement categories",
            "order": 9
          },
          "texra.latex.customReplacementsRegex": {
            "type": "object",
            "default": {},
            "description": "Custom regex replacements in the format: { 'pattern': 'replacement' }. Use capture groups with $1, $2, etc. Example: { '\\\\section\\{([^}]+)\\}': '\\section{$1}' }",
            "additionalProperties": {
              "type": "string"
            },
            "order": 10
          },
          "texra.latex.customReplacements": {
            "type": "object",
            "default": {},
            "description": "Custom LaTeX replacements in the format: { 'from': 'to' }. Example: { '\\alpha': '\\al' }",
            "additionalProperties": {
              "type": "string"
            },
            "order": 11
          }
        }
      },
      {
        "title": "LaTeXdiff",
        "properties": {
          "texra.latexdiff.timeoutMs": {
            "type": "number",
            "default": 10000,
            "minimum": 1000,
            "maximum": 80000,
            "description": "Timeout in milliseconds for latexdiff operations",
            "order": 1
          },
          "texra.latexdiff.mathMarkup": {
            "type": "string",
            "default": "coarse",
            "enum": [
              "off",
              "whole",
              "coarse",
              "fine"
            ],
            "enumDescriptions": [
              "Suppress markup for math environments. Deleted equations will not appear in diff file.",
              "Differencing on the level of whole equations. Even trivial changes cause the whole equation to be marked changed.",
              "Detect changes within equations with coarse granularity; changes in equation type appear as a change to the complete equation.",
              "Detect small changes in equations and mark up at fine granularity."
            ],
            "description": "Determine granularity of markup in displayed math environments for latexdiff",
            "order": 2
          },
          "texra.latexdiff.pictureEnvironments": {
            "type": "string",
            "default": "(?:picture|tikzpicture|scope|DIFnomarkup)[\\w\\d*@]*",
            "description": "Regular expression pattern for environments to be treated as pictures. These environments will be processed as a unit without internal differencing.",
            "order": 3
          }
        }
      },
      {
        "title": "Git",
        "properties": {
          "texra.git.numberOfCommitsToShow": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "description": "Number of recent commits to show in the commit selection dropdown",
            "order": 1
          }
        }
      },
      {
        "title": "Merge Operations",
        "properties": {
          "texra.merge.defaultModel": {
            "type": "string",
            "default": "gemini25f",
            "enum": [
              "sonnet4T",
              "gemini25p",
              "gemini25f",
              "gpt5",
              "gpt5-",
              "o3-mini",
              "gpt41",
              "deepseek",
              "deepseekT",
              "qwenplus",
              "kimi2"
            ],
            "enumDescriptions": [
              "Claude Sonnet 4T",
              "Gemini 2.5 Pro",
              "Gemini 2.5 Flash",
              "OpenAI GPT-5",
              "OpenAI GPT-5-",
              "OpenAI O3 Mini",
              "OpenAI GPT-4.1",
              "DeepSeek Chat",
              "DeepSeek Reasoner",
              "Qwen3 Plus (2025-07-28)",
              "Kimi K2"
            ],
            "description": "Default model to use for merge operations",
            "order": 1
          }
        }
      },
      {
        "title": "File Explorer",
        "properties": {
          "texra.explorer.agentsDirectory": {
            "type": "string",
            "default": "",
            "description": "Root path for the TeXRA file explorer view. Must be an absolute path.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Audio",
        "properties": {
          "texra.audio.soxPath": {
            "type": "string",
            "default": "",
            "description": "Path to the SoX executable. Overrides automatic detection.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "API Keys",
        "properties": {
          "texra.apiKeys.set": {
            "type": "null",
            "scope": "application",
            "markdownDescription": "API keys are now stored securely. [Click here to set an API key](command:texra.setApiKey)",
            "readOnly": true
          },
          "texra.apiKeys.remove": {
            "type": "null",
            "scope": "application",
            "markdownDescription": "API keys are now stored securely. [Click here to remove the stored key](command:texra.removeApiKey)",
            "readOnly": true
          }
        }
      },
      {
        "title": "Logger",
        "properties": {
          "texra.logger.debugMode": {
            "type": "boolean",
            "default": false,
            "description": "Whether to show verbose debug messages in the logger view",
            "scope": "resource"
          },
          "texra.debug.saveDebugObjects": {
            "type": "boolean",
            "default": false,
            "description": "Save message and response objects to JSON files for debugging purposes",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Progress Board",
        "properties": {
          "texra.progressBoard.streamSortOrder": {
            "type": "string",
            "default": "time",
            "enum": [
              "none",
              "time",
              "inputFile",
              "agent"
            ],
            "enumDescriptions": [
              "No sorting (maintain order of creation)",
              "Sort by last active time (newest first)",
              "Sort alphabetically by input file name",
              "Sort alphabetically by agent type"
            ],
            "description": "Default sort order for streams in the Progress Board",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Tool Use Agents",
        "properties": {
          "texra.toolUse.persistence.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Persist tool-use conversations across VS Code restarts",
            "scope": "resource"
          },
          "texra.toolUse.persistence.ttlHours": {
            "type": "number",
            "default": 72,
            "minimum": 1,
            "description": "Maximum age (in hours) to keep saved tool-use sessions before automatic cleanup",
            "scope": "resource"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "texra.createSampleProject",
        "title": "Create Sample Project",
        "category": "TeXRA"
      },
      {
        "command": "texra.cleanOutput",
        "title": "Clean All LLM Output Files",
        "category": "TeXRA",
        "icon": "$(trash)"
      },
      {
        "command": "texra.cleanBuild",
        "title": "Clean All Build Files",
        "category": "TeXRA",
        "icon": "$(remove)"
      },
      {
        "command": "texra.indentTeX",
        "title": "Indent All LaTeX Files",
        "category": "TeXRA",
        "icon": "$(indent)"
      },
      {
        "command": "texra.getRecentCommits",
        "title": "Get Recent Commits",
        "category": "TeXRA"
      },
      {
        "command": "texra.refreshCommits",
        "title": "Refresh Commits",
        "category": "TeXRA"
      },
      {
        "command": "texra.indentCurrentTeX",
        "title": "Indent Current TeX",
        "category": "TeXRA",
        "icon": "$(indent)",
        "enablement": "!virtualWorkspace"
      },
      {
        "command": "texra.resumeAgent",
        "title": "Resume Tool-Use Agent",
        "category": "TeXRA"
      },
