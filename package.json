{
  "name": "coauthor",
  "displayName": "CoAuthor",
  "description": "CoAuthor: your never complain nor PUA nor on two-month holidays coauthor.",
  "version": "0.23.6",
  "publisher": "Sirui-Lu",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "AI"
  ],
  "activationEvents": [
    "onView:coauthor",
    "onColorTheme"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "CoAuthor",
        "properties": {
          "coauthor.agents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "correct",
              "derive",
              "polish",
              "draw",
              "ocr",
              "paper2cover",
              "paper2slide",
              "paper2poster",
              "paper2note",
              "polish_cover",
              "solve_qi"
            ],
            "description": "List of available agents",
            "scope": "resource"
          },
          "coauthor.models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "sonnet37T",
              "sonnet37",
              "sonnet35",
              "opus",
              "o3-",
              "o1",
              "o1-",
              "gpt45",
              "gpt4o",
              "gpt4ol",
              "gemini2p",
              "gemini2f",
              "gemini2fT",
              "DSV3",
              "DSR1"
            ],
            "description": "List of available models",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Model Settings",
        "properties": {
          "coauthor.model.useOpenRouter": {
            "type": "boolean",
            "default": false,
            "description": "Whether to use OpenRouter for API calls when possible",
            "scope": "resource"
          },
          "coauthor.model.useStreaming": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming API responses when supported by the model. This will be more robust for long responses.",
            "scope": "resource"
          },
          "coauthor.model.useStreamingAnthropicReasoning": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming API responses when supported by the Anthropic model. This will be more robust for long responses. This overrides the coauthor.model.useStreaming setting.",
            "scope": "resource"
          },
          "coauthor.model.useStreamingOpenAIReasoning": {
            "type": "boolean",
            "default": false,
            "description": "Enable streaming API responses when supported by the OpenAI model. This will be more robust for long responses. This overrides the coauthor.model.useStreaming setting.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "File Handling",
        "properties": {
          "coauthor.files.included.figureExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".png",
              ".pdf",
              ".jpeg",
              ".jpg",
              ".svg",
              ".gif",
              ".bmp"
            ],
            "description": "File extensions to include when searching for figures",
            "editPresentation": "multilineText",
            "order": 4
          },
          "coauthor.files.included.inputExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md"
            ],
            "description": "File extensions to include when searching for input files",
            "editPresentation": "multilineText",
            "order": 5
          },
          "coauthor.files.included.referenceExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".md"
            ],
            "description": "File extensions to include when searching for reference files",
            "editPresentation": "multilineText",
            "order": 6
          },
          "coauthor.files.included.auxiliaryExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex",
              ".cls",
              ".md"
            ],
            "description": "File extensions to include when searching for auxiliary files",
            "editPresentation": "multilineText",
            "order": 7
          },
          "coauthor.files.included.editedExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".txt",
              ".tex"
            ],
            "description": "File extensions to include when searching for edited files",
            "editPresentation": "multilineText",
            "order": 8
          },
          "coauthor.files.ignored.fileExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".pdf",
              ".bst",
              ".bib",
              ".json",
              ".py",
              ".ipynb",
              ".png",
              ".vsix",
              ".ts",
              ".js"
            ],
            "description": "File extensions to ignore when listing text files",
            "editPresentation": "multilineText",
            "order": 9
          },
          "coauthor.files.ignored.inputFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "command.tex",
              "preamble.tex"
            ],
            "description": "Files to ignore when listing input, sample, and edited files, but not auxiliary files",
            "editPresentation": "multilineText",
            "order": 10
          },
          "coauthor.files.ignored.auxiliaryKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "o1",
              "o3",
              "gpt",
              "sonnet",
              "haiku",
              "opus",
              "gemini",
              "grok",
              "deepseek",
              "llama",
              "egg-info"
            ],
            "description": "Additional keywords to ignore when listing auxiliary files, including model names",
            "editPresentation": "multilineText",
            "order": 11
          },
          "coauthor.files.ignored.figureDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "versions",
              "history"
            ],
            "description": "Directories to ignore in the figure path",
            "editPresentation": "multilineText",
            "order": 12
          },
          "coauthor.files.ignored.directories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "build",
              "node_modules",
              "__pycache__",
              "figures",
              "figs",
              "versions",
              "history",
              "stuff",
              "draft",
              "diff",
              "miscellaneous",
              "venv"
            ],
            "description": "Directories to ignore when listing files",
            "editPresentation": "multilineText",
            "order": 13
          },
          "coauthor.files.ignored.keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Makefile",
              "template",
              "_log",
              "_thinking",
              "_diff",
              "diff",
              "draw",
              "versions",
              "history",
              ".egg-info"
            ],
            "description": "Keywords to ignore when selecting files",
            "editPresentation": "multilineText",
            "order": 14
          }
        }
      },
      {
        "title": "LaTeX",
        "properties": {
          "coauthor.latex.latexindentConfig": {
            "type": "string",
            "default": "",
            "description": "Path to latexindent configuration file",
            "editPresentation": "singlelineText",
            "order": 1
          },
          "coauthor.latex.tikzInputDirectory": {
            "type": "string",
            "default": "",
            "description": "Directory where to look for extra input files when compiling extracted TikZ figures. Absolute path is required. Sets TEXINPUTS environment variable for TikZ compilation.",
            "editPresentation": "singlelineText",
            "order": 2
          },
          "coauthor.latex.tikzTemplate": {
            "type": "string",
            "default": "\\documentclass[tikz,border=10pt]{standalone}\n\\usepackage{tikz}\n\\usepackage{pgfplots}\n\\usetikzlibrary{positioning}\n\\usetikzlibrary{patterns}\n\\usetikzlibrary{arrows.meta, shapes.geometric, matrix, calc, decorations.pathreplacing}\n\\usetikzlibrary{shapes, arrows}\n\n\\begin{document}\n{{ tikzpicture }}\n\\end{document}",
            "description": "Template used for generating standalone documents when extracting and compiling TikZ figures",
            "editPresentation": "multilineText",
            "order": 3
          },
          "coauthor.latex.includeWorkspaceInTexinputs": {
            "type": "boolean",
            "default": true,
            "description": "Include the workspace root directory in TEXINPUTS when compiling TikZ figures",
            "order": 4
          },
          "coauthor.latex.enabledReplacements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "latex_spacing",
                "equations",
                "sections",
                "characters",
                "latex_xml",
                "scratchpad_xml",
                "style",
                "personal_style",
                "max_style"
              ]
            },
            "default": [
              "latex_spacing",
              "equations",
              "sections",
              "characters",
              "latex_xml",
              "scratchpad_xml",
              "style",
              "max_style"
            ],
            "description": "List of enabled LaTeX replacement categories",
            "order": 5
          },
          "coauthor.latex.customReplacements": {
            "type": "object",
            "default": {},
            "description": "Custom LaTeX replacements in the format: { 'from': 'to' }. Example: { '\\alpha': '\\al' }",
            "additionalProperties": {
              "type": "string"
            },
            "order": 6
          }
        }
      },
      {
        "title": "Execution",
        "properties": {
          "coauthor.agent.pauseForConfirmation": {
            "type": "boolean",
            "default": false,
            "description": "Whether to pause for confirmation after each agent even with reflect=True",
            "scope": "resource"
          }
        }
      },
      {
        "title": "Git",
        "properties": {
          "coauthor.git.numberOfCommitsToShow": {
            "type": "number",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "description": "Number of recent commits to show in the commit selection dropdown",
            "order": 1
          }
        }
      },
      {
        "title": "Merge Operations",
        "properties": {
          "coauthor.merge.defaultModel": {
            "type": "string",
            "default": "sonnet37",
            "enum": [
              "sonnet37",
              "sonnet35",
              "gemini2fT",
              "gemini2f",
              "gemini2p",
              "o3-mini",
              "gpt4o"
            ],
            "enumDescriptions": [
              "Claude Sonnet 3.7",
              "Claude Sonnet 3.5",
              "Gemini 2 Flash Thinking",
              "Gemini 2 Flash",
              "Gemini 2 Pro",
              "OpenAI O3 Mini",
              "OpenAI GPT-4O"
            ],
            "description": "Default model to use for merge operations",
            "order": 1
          },
          "coauthor.merge.defaultReflect": {
            "type": "string",
            "default": "False",
            "enum": [
              "True",
              "False"
            ],
            "description": "Default reflect setting for merge operations",
            "order": 2
          }
        }
      },
      {
        "title": "Code Validation & Fixing",
        "properties": {
          "coauthor.xmlValidator.maxIterations": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 20,
            "description": "Maximum number of iterations when trying to fix XML validation errors",
            "order": 1
          },
          "coauthor.linterFixer.maxIterations": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 20,
            "description": "Maximum number of iterations when trying to fix linter issues in code files",
            "order": 2
          },
          "coauthor.autoFix.latex": {
            "type": "boolean",
            "default": false,
            "description": "Automatically trigger LaTeX linter fix when linter issues are detected",
            "order": 3
          },
          "coauthor.autoFix.xml": {
            "type": "boolean",
            "default": false,
            "description": "Automatically trigger XML validation fix when XML validation issues are detected",
            "order": 4
          }
        }
      },
      {
        "title": "File Explorer",
        "properties": {
          "coauthor.explorer.agentsDirectory": {
            "type": "string",
            "default": "",
            "description": "Root path for the CoAuthor file explorer view. Can be absolute or relative to workspace root.",
            "scope": "resource"
          }
        }
      },
      {
        "title": "API Keys",
        "properties": {
          "coauthor.apiKeys.set": {
            "type": "null",
            "scope": "application",
            "markdownDescription": "API keys are now stored securely. [Click here to set an API key](command:coauthor.setApiKey)",
            "readOnly": true
          },
          "coauthor.apiKeys.remove": {
            "type": "null",
            "scope": "application",
            "markdownDescription": "API keys are now stored securely. [Click here to remove the stored key](command:coauthor.removeApiKey)",
            "readOnly": true
          }
        }
      },
      {
        "title": "Logger",
        "properties": {
          "coauthor.logger.verboseOutput": {
            "type": "boolean",
            "default": false,
            "description": "Whether to show verbose debug messages in the logger view",
            "scope": "resource"
          },
          "coauthor.debug.saveMessageObjects": {
            "type": "boolean",
            "default": false,
            "description": "Save message JSON objects to files before API calls for debugging purposes",
            "scope": "resource"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "coauthor.cleanOutput",
        "title": "Clean All LLM Output Files",
        "category": "CoAuthor",
        "icon": "$(trash)"
      },
      {
        "command": "coauthor.cleanBuild",
        "title": "Clean All Build Files",
        "category": "CoAuthor",
        "icon": "$(clear-all)"
      },
      {
        "command": "coauthor.indentTeX",
        "title": "Indent All LaTeX Files",
        "category": "CoAuthor",
        "icon": "$(indent)"
      },
      {
        "command": "coauthor.getRecentCommits",
        "title": "Get Recent Commits",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.refreshCommits",
        "title": "Refresh Commits",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.indentCurrentTeX",
        "title": "Indent Current TeX",
        "category": "CoAuthor",
        "icon": "$(indent)",
        "enablement": "!virtualWorkspace"
      },
      {
        "command": "coauthor.countPdfPages",
        "title": "Count PDF Pages",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.encodeImageToBase64",
        "title": "Encode Image to Base64",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.convertPdfToImages",
        "title": "Convert PDF to Images",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.testPdfToImage",
        "title": "Test PDF to Image Conversion",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.extractFigurePaths",
        "title": "Extract Figure Paths from LaTeX",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.extractTikzFigures",
        "title": "Extract TikZ Figures from Current File",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.compileTikzFigures",
        "title": "Compile TikZ Figures from Current File",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.getTeXCount",
        "title": "Count Words in Current TeX File",
        "category": "CoAuthor",
        "icon": "$(symbol-number)",
        "enablement": "!virtualWorkspace"
      },
      {
        "command": "coauthor.testConnection",
        "title": "Test Text Connection Methods",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.testAgentLoading",
        "title": "Test Agent Loading",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.loadSpecificAgent",
        "title": "Load Specific Agent",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.parseXml",
        "title": "Parse XML Structure",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.validateAndFixXml",
        "title": "Validate and Fix XML using Claude",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.parseYaml",
        "title": "Parse YAML Structure",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.testYamlBrackets",
        "title": "Test YAML Bracket Handling",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.stopAgent",
        "title": "Stop Agent",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.execute",
        "title": "Execute Agent",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.pack",
        "title": "Pack Files",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.clean",
        "title": "Clean Files",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.folderExplorer.newFile",
        "title": "New File",
        "category": "CoAuthor",
        "icon": "$(new-file)"
      },
      {
        "command": "coauthor.folderExplorer.newFolder",
        "title": "New Folder",
        "category": "CoAuthor",
        "icon": "$(new-folder)"
      },
      {
        "command": "coauthor.folderExplorer.rename",
        "title": "Rename",
        "category": "CoAuthor",
        "icon": "$(edit)"
      },
      {
        "command": "coauthor.folderExplorer.delete",
        "title": "Delete",
        "category": "CoAuthor",
        "icon": "$(trash)"
      },
      {
        "command": "coauthor.setApiKey",
        "title": "Set API Key",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.removeApiKey",
        "title": "Remove API Key",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.testTextEditor",
        "title": "Test Text Editor Tool",
        "category": "CoAuthor",
        "icon": "$(edit)"
      },
      {
        "command": "coauthor.showLinterMessages",
        "title": "Show Linter Messages",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.countLinterMessages",
        "title": "Count Linter Messages",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.fixLinterIssues",
        "title": "Fix Linter Issues with Claude",
        "category": "CoAuthor",
        "icon": "$(fix-all)"
      },
      {
        "command": "coauthor.testWolframAlpha",
        "title": "Test Wolfram Alpha API Connection",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.wolframAlphaQuery",
        "title": "Query Wolfram Alpha",
        "category": "CoAuthor"
      },
      {
        "command": "coauthor.showAgentHistory",
        "title": "Show Agent Execution History",
        "category": "CoAuthor"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coauthor",
          "title": "CoAuthor",
          "icon": "resources/quantum-deer.svg"
        }
      ],
      "panel": [
        {
          "id": "coauthor-panel",
          "title": "CoAuthor ProgressBoard",
          "icon": "$(server-process)"
        }
      ]
    },
    "views": {
      "coauthor": [
        {
          "type": "webview",
          "id": "coauthor.mainView",
          "name": "Your Favourite CoAuthor",
          "contextualTitle": "CoAuthor"
        },
        {
          "id": "coauthor.folderExplorer",
          "name": "TeX Agents",
          "when": "workbenchState != empty"
        },
        {
          "type": "webview",
          "id": "coauthor.historyView",
          "name": "Agent History",
          "when": "workbenchState != empty"
        }
      ],
      "coauthor-panel": [
        {
          "type": "webview",
          "id": "coauthor.progressView",
          "name": "CoAuthor: ProgressBoard",
          "contextualTitle": "ProgressBoard",
          "icon": "$(server-process)"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "coauthor.indentCurrentTeX",
          "group": "navigation"
        },
        {
          "when": "editorLangId =~ /^latex$|^latex-expl3$|^doctex$/",
          "command": "coauthor.getTeXCount",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "coauthor.indentTeX",
          "when": "view == coauthor.progressView",
          "group": "navigation@1"
        },
        {
          "command": "coauthor.cleanOutput",
          "when": "view == coauthor.progressView",
          "group": "navigation@2"
        },
        {
          "command": "coauthor.cleanBuild",
          "when": "view == coauthor.progressView",
          "group": "navigation@3"
        },
        {
          "command": "coauthor.folderExplorer.newFile",
          "when": "view == coauthor.folderExplorer",
          "group": "navigation"
        },
        {
          "command": "coauthor.folderExplorer.newFolder",
          "when": "view == coauthor.folderExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "coauthor.folderExplorer.newFile",
          "when": "view == coauthor.folderExplorer && viewItem == folder",
          "group": "1_modification"
        },
        {
          "command": "coauthor.folderExplorer.newFolder",
          "when": "view == coauthor.folderExplorer && viewItem == folder",
          "group": "1_modification"
        },
        {
          "command": "coauthor.folderExplorer.rename",
          "when": "view == coauthor.folderExplorer && viewItem != editing",
          "group": "2_modification"
        },
        {
          "command": "coauthor.folderExplorer.delete",
          "when": "view == coauthor.folderExplorer && viewItem != editing",
          "group": "3_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "build": "npm run compile && vsce package --out releases/coauthor-$npm_package_version.vsix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/difflib": "^0.2.7",
    "@types/marked": "^5.0.2",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.68",
    "@types/nunjucks": "^3.2.5",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-electron": "^2.4.0",
    "chokidar": "^3.6.0",
    "eslint": "^8.57.0",
    "node-loader": "^2.1.0",
    "nunjucks": "^3.2.4",
    "path-browserify": "^1.0.1",
    "prettier": "^3.4.2",
    "spawn-sync": "^2.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LionSR/coauthor.git"
  },
  "license": "MIT",
  "author": "Sirui LU",
  "icon": "resources/quantum-deer.png",
  "keywords": [
    "latex",
    "academic",
    "writing",
    "coauthor",
    "vscode",
    "research"
  ],
  "bugs": {
    "url": "https://github.com/LionSR/coauthor/issues"
  },
