{
  "name": "coauthor",
  "displayName": "CoAuthor",
  "description": "CoAuthor",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:coauthor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "coauthor.clean",
        "title": "Clean"
      },
      {
        "command": "coauthor.cleanBuild",
        "title": "Clean All"
      },
      {
        "command": "coauthor.indentTex",
        "title": "Indent TeX"
      },
      {
        "command": "coauthor.selectInputFile",
        "title": "Select Input File"
      },
      {
        "command": "coauthor.selectAuxFile",
        "title": "Select Auxiliary File"
      },
      {
        "command": "coauthor.execute",
        "title": "Execute Task"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coauthor",
          "title": "CoAuthor",
          "icon": "resources/unicorn.svg"
        }
      ]
    },
    "views": {
      "coauthor": [
        {
          "type": "webview",
          "id": "coauthor.chatView",
          "name": "CoAuthor Panel"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.89.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "ts-loader": "^9.5.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "@vscode/test-cli": "^0.1.9",
    "@vscode/test-electron": "^2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LionSR/coauthor-for-vs-code.git"
  },
  "license": "MIT"
}