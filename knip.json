{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/test-kernel/**/*.vitest.ts",
        "src/test-kernel/support/setupFakePlatform.ts",
        "src/test-kernel/desktop/electronTestStub.ts",
        "scripts/**/*.mjs!"
      ],
      "project": ["src/**/*.{ts,mts}!", "!src/**/*.js", "!src/test-kernel/**!"],
      "ignoreDependencies": [
        "@electron/asar",
        "@jitl/quickjs-wasmfile-release-sync"
      ]
    },
    "packages/extension": {
      "entry": ["src/**/frontend/index.ts!"],
      "project": ["src/**/*.{ts,tsx,mts}!"]
    },
    "packages/harness": {
      "entry": [
        "src/index.ts!",
        "src/node.ts!",
        "src/plugins.ts!",
        "src/schemas.ts!",
        "src/agent/codeSandbox/worker.ts!",
        "scripts/*.mjs!"
      ],
      "project": ["src/**/*.{ts,mts}!", "scripts/*.mjs!"],
      "ignoreDependencies": ["@typescript/native"]
    },
    "packages/llm": {
      "entry": ["test-live/**/*.ts"],
      "project": ["src/**/*.{ts,mts}!"]
    },
    "packages/cli": {
      "entry": [
        "src/bin/texra.ts!",
        "src/bin/texraServe.ts!",
        "scripts/{build-bundle,copy-docs,copy-resources}.mjs!",
        "scripts/**/*.{ts,tsx,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx,mts}!"],
      "ignoreDependencies": [
        "@babel/preset-react",
        "@babel/preset-typescript",
        "babel-plugin-react-compiler"
      ]
    },
    "packages/desktop": {
      "entry": [
        "src/main/bootstrap.ts!",
        "src/main/index.ts!",
        "src/preload/index.ts!",
        "tests/**/*.{ts,tsx}",
        "design-harness/**/*.{ts,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx,mts}!"],
      "ignoreDependencies": ["electron-builder"]
    }
  }
}
