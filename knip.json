{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/test-kernel/**/*.vitest.ts",
        "src/test-kernel/support/setupFakePlatform.ts",
        "scripts/**/*.mjs!"
      ],
      "project": ["src/**/*.{ts,mts}!", "!src/**/*.js", "!src/test-kernel/**!"]
    },
    "packages/extension": {
      "entry": ["src/**/frontend/index.ts!"],
      "project": ["src/**/*.{ts,tsx,mts}!"]
    },
    "packages/agent": {
      "entry": [
        "src/index.ts!",
        "src/effect.ts!",
        "src/node.ts!",
        "src/schemas.ts!",
        "scripts/*.mjs!"
      ],
      "project": ["src/**/*.{ts,mts}!", "scripts/*.mjs!"]
    },
    "packages/llm": {
      "project": ["src/**/*.{ts,mts}!"]
    },
    "packages/cli": {
      "entry": ["src/bin/texra.ts!", "scripts/**/*.{ts,tsx,mjs}!"],
      "project": ["src/**/*.{ts,tsx,mts}!"]
    },
    "packages/desktop": {
      "entry": [
        "src/main/bootstrap.ts!",
        "src/main/index.ts!",
        "src/preload/index.ts!",
        "tests/**/*.{ts,tsx}",
        "design-harness/**/*.{ts,mjs}!"
      ],
      "project": ["src/**/*.{ts,tsx,mts}!"]
    },
    "packages/trace-viewer": {
      "entry": ["vite.standalone.config.ts"]
    }
  }
}
