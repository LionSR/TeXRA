{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [".*"],
  "ignoreBinaries": [".*"],
  "workspaces": {
    ".": {
      "entry": ["src/test-kernel/**/*.vitest.{ts,mts}", "scripts/**/*.mjs"],
      "project": ["src/**/*.{ts,mts}"],
      "ignore": ["src/platform/index.ts"]
    },
    "packages/extension": {
      "entry": ["src/extension.ts", "src/**/frontend/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/cli": {
      "entry": ["src/bin/texra.ts", "scripts/**/*.{ts,tsx,mjs}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/desktop": {
      "entry": [
        "src/main/bootstrap.ts",
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/main.ts",
        "tests/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/renderer/vite-env.d.ts"]
    }
  }
}
