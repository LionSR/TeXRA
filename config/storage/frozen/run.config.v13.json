{
  "dialect": "draft-2020-12",
  "schema": {
    "type": "object",
    "properties": {
      "aggregateId": {
        "type": "string",
        "minLength": 3
      },
      "stageId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "run.config"
        ]
      },
      "config": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "instruction": {
                "type": "string"
              },
              "workingDirectory": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "model": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "instruction"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "inputFiles": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "contextFiles": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mediaFiles": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outputFiles": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label": {
                "type": "string"
              },
              "system": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tools": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "temperature": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "Infinity",
                      "-Infinity",
                      "NaN"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "toolScope": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "declared",
                      "topLevel"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "model": {
                "type": "string"
              },
              "instruction": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rootUserInstruction": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "displayInstruction": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "memories": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "skills": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 20
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "workingDirectory": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "launch": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outputSchema": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "script": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "background"
                        ]
                      },
                      "code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "tools": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "timeoutMs": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "maximum": 9007199254740991,
                            "exclusiveMinimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "code",
                      "title",
                      "tools"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "program"
                        ]
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "args": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "kind",
                      "name",
                      "args"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "label",
              "model"
            ],
            "additionalProperties": true
          }
        ]
      },
      "binding": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "backend": {
                "type": "string",
                "minLength": 1
              },
              "declinedRoutes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "chatgpt-subscription",
                    "xai-subscription",
                    "kimi-code-subscription",
                    "glm-coding-plan-subscription"
                  ]
                }
              }
            },
            "required": [
              "backend",
              "declinedRoutes"
            ],
            "additionalProperties": true
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "aggregateId",
      "type",
      "config"
    ],
    "additionalProperties": true
  },
  "definitions": {}
}
