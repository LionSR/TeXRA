{
  "dialect": "draft-2020-12",
  "schema": {
    "type": "object",
    "properties": {
      "aggregateId": {
        "type": "string",
        "minLength": 3
      },
      "stageId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "tool.intent"
        ]
      },
      "payload": {
        "type": "object",
        "properties": {
          "origin": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "response"
                    ]
                  },
                  "responseId": {
                    "type": "string",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
                    "format": "uuid"
                  }
                },
                "required": [
                  "kind",
                  "responseId"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "script"
                    ]
                  },
                  "scriptCallId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "scriptCallId"
                ],
                "additionalProperties": true
              }
            ]
          },
          "callId": {
            "type": "string",
            "minLength": 1
          },
          "attempt": {
            "type": "integer",
            "maximum": 9007199254740991,
            "exclusiveMinimum": 0
          },
          "logId": {
            "type": "string",
            "minLength": 1
          },
          "toolName": {
            "type": "string",
            "minLength": 1
          },
          "input": {},
          "card": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "sections": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "text"
                              ]
                            },
                            "label": {
                              "type": "string"
                            },
                            "text": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "label",
                            "text"
                          ],
                          "additionalProperties": true
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "status"
                              ]
                            },
                            "label": {
                              "type": "string"
                            },
                            "status": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "in_progress"
                                  ],
                                  "title": "IN_PROGRESS"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "completed"
                                  ],
                                  "title": "COMPLETED"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "failed"
                                  ],
                                  "title": "FAILED"
                                }
                              ]
                            }
                          },
                          "required": [
                            "kind",
                            "label",
                            "status"
                          ],
                          "additionalProperties": true
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "identifier"
                              ]
                            },
                            "label": {
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "label",
                            "value"
                          ],
                          "additionalProperties": true
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "badges"
                              ]
                            },
                            "label": {
                              "type": "string"
                            },
                            "badges": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "label",
                            "badges"
                          ],
                          "additionalProperties": true
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "fileList"
                              ]
                            },
                            "label": {
                              "type": "string"
                            },
                            "files": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "path": {
                                    "type": "string"
                                  },
                                  "note": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "path"
                                ],
                                "additionalProperties": true
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "label",
                            "files"
                          ],
                          "additionalProperties": true
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "title",
                  "sections"
                ],
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "origin",
          "callId",
          "attempt",
          "logId",
          "toolName",
          "input"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "aggregateId",
      "type",
      "payload"
    ],
    "additionalProperties": true
  },
  "definitions": {}
}
