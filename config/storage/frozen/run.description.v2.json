{
  "dialect": "draft-2020-12",
  "schema": {
    "type": "object",
    "properties": {
      "aggregateId": {
        "type": "string",
        "minLength": 3
      },
      "stageId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "type": {
        "type": "string",
        "enum": ["run.description"]
      },
      "description": {
        "type": "string"
      },
      "by": {
        "type": "string",
        "enum": ["model", "user"]
      },
      "usage": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "inputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cost": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": ["Infinity", "-Infinity", "NaN"]
                  }
                ]
              },
              "cachedInputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cacheMissInputTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cacheWriteTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reasoningTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "toolUsePromptTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "usageRoute": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "chatgpt-subscription",
                      "xai-subscription",
                      "kimi-code-subscription",
                      "glm-coding-plan-subscription",
                      "api-key"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "usagePlan": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "responseTimeMs": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": ["Infinity", "-Infinity", "NaN"]
                  }
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "inputTokens",
              "outputTokens",
              "cost",
              "responseTimeMs",
              "provider"
            ],
            "additionalProperties": true
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": ["aggregateId", "type", "description", "by"],
    "additionalProperties": true
  },
  "definitions": {}
}
