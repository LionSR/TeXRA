{
  "dialect": "draft-2020-12",
  "schema": {
    "type": "object",
    "properties": {
      "aggregateId": {
        "type": "string",
        "minLength": 3
      },
      "stageId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "type": {
        "type": "string",
        "enum": ["hook.outcome"]
      },
      "payload": {
        "type": "object",
        "properties": {
          "point": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "enum": [
              "SessionStart",
              "UserPromptSubmit",
              "PreToolUse",
              "PostToolUse",
              "Stop",
              "SubagentStop"
            ]
          },
          "plugin": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "failed",
              "timeout",
              "malformed",
              "unstartable"
            ]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "decision": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["allow", "deny", "ask"]
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedInput": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ignored": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stderr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "point",
          "event",
          "plugin",
          "hook",
          "durationMs",
          "status",
          "exitCode",
          "decision",
          "reason",
          "updatedInput",
          "context",
          "ignored",
          "stderr"
        ],
        "additionalProperties": true
      }
    },
    "required": ["aggregateId", "type", "payload"],
    "additionalProperties": true
  },
  "definitions": {}
}
