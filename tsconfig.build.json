{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "packages/agent/dist/types",
    "rootDir": ".",
    "removeComments": true,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@shared/*": ["src/shared/*.ts", "src/shared/*/index.ts"],
      "@common/*": ["src/common/*.ts", "src/common/*/index.ts"],
      "@agent/*": ["src/agent/*.ts", "src/agent/*/index.ts"],
      "@hosts/*": ["src/hosts/*.ts", "src/hosts/*/index.ts"],
      "@utils/*": ["src/utils/*.ts", "src/utils/*/index.ts"],
      "@logger/*": ["src/logger/*.ts", "src/logger/*/index.ts"],
      "@telemetry/*": ["src/telemetry/*.ts", "src/telemetry/*/index.ts"],
      "@transcript": ["src/transcript/index.ts"],
      "@transcript/*": ["src/transcript/*.ts", "src/transcript/*/index.ts"],
      "@latex/*": ["src/latex/*.ts", "src/latex/*/index.ts"],
      "@model": ["src/model/index.ts"],
      "@model/*": ["src/model/*.ts", "src/model/*/index.ts"],
      "@skills/*": ["src/skills/*.ts", "src/skills/*/index.ts"],
      "@housekeeping": ["src/housekeeping/index.ts"],
      "@housekeeping/*": [
        "src/housekeeping/*.ts",
        "src/housekeeping/*/index.ts"
      ],
      "@replacement/*": ["src/replacement/*.ts", "src/replacement/*/index.ts"],
      "@tools/*": ["src/tools/*.ts", "src/tools/*/index.ts"],
      "@eventBus/*": ["src/eventBus/*.ts", "src/eventBus/*/index.ts"],
      "@auth/*": ["src/auth/*.ts", "src/auth/*/index.ts"],
      "@platform/*": ["src/platform/*.ts", "src/platform/*/index.ts"]
    }
  },
  "include": ["packages/agent/src/**/*.ts", "src/types/ambient.d.ts"],
  "exclude": ["node_modules", "src/test-kernel"]
}
