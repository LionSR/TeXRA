{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "packages/harness/dist/types",
    "rootDir": ".",
    "removeComments": true,
    "types": ["node"]
  },
  "include": [
    "packages/harness/src/index.ts",
    "packages/harness/src/node.ts",
    "packages/harness/src/plugins.ts",
    "packages/harness/src/schemas.ts",
    "packages/harness/src/effect/**/*.ts",
    "packages/llm/src/**/*.ts",
    "packages/harness/src/types/ambient.d.ts"
  ],
  "exclude": ["node_modules", "src/test-kernel"]
}
