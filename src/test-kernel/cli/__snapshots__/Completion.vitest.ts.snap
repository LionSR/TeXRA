"
`;

exports[`CLI shell completion > generates zsh completion 1`] = `
"#compdef texra

_texra_agents() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra agents list --quiet 2>/dev/null | awk '{print $2}'
}

_texra_models() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra models list --quiet 2>/dev/null | awk '{print $1}'
}

_texra_workflow_agents() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra agents list --quiet --all --category workflow 2>/dev/null | awk '{print $2}'
}

_texra_tool_use_agents() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra agents list --quiet --all --category toolUse 2>/dev/null | awk '{print $2}'
}

_texra() {
  local path
  path="\${words[2]}"
  [[ -n "\${words[3]}" && "\${words[3]}" != -* ]] && path="$path \${words[3]}"

  case "$path" in
    orchestrate) true; _arguments '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--include-interop[Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory]' '--source[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '-s[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' ;;
    chat) true; _arguments '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--include-interop[Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory]' '--source[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '-s[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '--agent[Tool-use agent for the session]:agent:($(_texra_tool_use_agents))' '--model[Model for the session]:model:($(_texra_models))' '-m[Model for the session]:model:($(_texra_models))' ;;
    clone) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Empty directory to clone into (defaults to the current directory)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' ;;
    run) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--include-interop[Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory]' '--source[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '-s[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '--input[Input file passed to the workflow agent (repeatable; use \`-\` to read stdin)]:file:' '-i[Input file passed to the workflow agent (repeatable; use \`-\` to read stdin)]:file:' '--context[Read-only context file passed to the workflow agent (repeatable; use \`-\` to read stdin)]:file:' '-c[Read-only context file passed to the workflow agent (repeatable; use \`-\` to read stdin)]:file:' '--output[Output file for a single-input run (use --output-dir for multi-input)]:file:' '--output-dir[Directory to copy outputs into for multi-input runs]:directory:' '--model[Model for the agent]:model:($(_texra_models))' '-m[Model for the agent]:model:($(_texra_models))' '--instruction[Instruction passed to the workflow agent]:value:' '--instruction-file[File whose contents are passed before --instruction when both are set]:file:' 1\\:agent:\\(\\$\\(_texra_workflow_agents\\)\\) ;;
    resume) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--include-interop[Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory]' '--source[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '-s[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' ;;
    setup) true; _arguments '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' ;;
    init) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory to initialize (defaults to $PWD)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--yes[Accept defaults non-interactively]' '-y[Accept defaults non-interactively]' '--force[Overwrite an existing config file]' '--gitignore[Add .texra/ to .gitignore (non-interactive default: false)]' ;;
    config) _values 'subcommands' edit show agents; true ;;
    'config edit') true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' ;;
    'config show') true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' ;;
    'config agents') true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--inherit[Use the user default team, or all agents when none is set]' '--all[Show every agent]' '--team[Use a built-in or saved team id]:value:' '--workflow[Use an exact comma-separated workflow-agent list]:agent,...:' '--tool-use[Use an exact comma-separated tool-use-agent list]:agent,...:' '--default-team[Set the user default team used by inherited workspaces]:value:' '--clear-default[Clear the user default team]' '--default-agent[Set the default root agent for chats in this workspace]:value:' '--clear-default-agent[Return chat-agent selection to the automatic default]' ;;
    install-github-action) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--branch[Branch to create for the PR (default: texra/add-code-review)]:value:' '--base[Base branch for the PR (default: the repo default branch)]:value:' '--force[Overwrite an existing workflow file / reuse the branch]' '--pr[Push the branch and open a pull request]' '--no-pr[Only scaffold and commit; do not push or open a PR]' ;;
    history) _values 'subcommands' list show delete; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' ;;
    'history list') true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--limit[Show at most this many executions]:count:' '-n[Show at most this many executions]:count:' ;;
