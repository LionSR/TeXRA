// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CLI shell completion > generates bash completion 1`] = `
"# bash completion for texra
_texra_completion_dynamic() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" != "0" ]]
}

_texra_agents() {
  _texra_completion_dynamic || return 0
  texra agents list --quiet 2>/dev/null | awk '{print $2}'
}

_texra_models() {
  _texra_completion_dynamic || return 0
  texra models list --quiet 2>/dev/null | awk '{print $1}'
}

_texra_workflow_agents() {
  _texra_completion_dynamic || return 0
  texra agents list --quiet --all --category workflow 2>/dev/null | awk '{print $2}'
}

_texra_tool_use_agents() {
  _texra_completion_dynamic || return 0
  texra agents list --quiet --all --category toolUse 2>/dev/null | awk '{print $2}'
}

_texra_compgen_files() {
  local candidate
  COMPREPLY=()
  while IFS= read -r candidate; do
    COMPREPLY+=("$candidate")
  done < <(compgen -f -- "$1")
  compopt -o filenames 2>/dev/null || true
}

_texra_compgen_dirs() {
  local candidate
  COMPREPLY=()
  while IFS= read -r candidate; do
    COMPREPLY+=("$candidate")
  done < <(compgen -d -- "$1")
  compopt -o filenames 2>/dev/null || true
}

_texra_completion_path() {
  local i=1 path="" token next
  while (( i < COMP_CWORD )); do
    token="\${COMP_WORDS[i]}"
    case "$token" in
      --cwd|--output-format|--approval-policy|--source|-s|--agent|--model|-m|--input|-i|--context|-c|--output|--output-dir|--instruction|--instruction-file|--team|--workflow|--tool-use|--default-team|--default-agent|--branch|--base|--limit|-n|--export|--assets-dir|--category|--login-hint)
        ((i+=2)); continue ;;
      --*=*|-*) ((i++)); continue ;;
    esac
    next="$token"
    [[ -n "$path" ]] && next="$path $token"
    case " orchestrate chat clone run resume setup init config config edit config show config agents install-github-action history history list history show history delete memory memory list memory show agents agents list agents show agents run skills skills list tools tools list tools status tools enable tools disable tools install tools auth multi-agent multi-agent list multi-agent show multi-agent run models models list models show models enabled models enable models disable login logout auth auth login auth logout auth status auth chatgpt auth chatgpt login auth chatgpt logout auth chatgpt status auth grok auth grok login auth grok logout auth grok status doctor completion version help " in
      *" $next "*) path="$next"; ((i++)); continue ;;
    esac
    break
  done
  printf '%s' "$path"
}

_texra() {
  local cur prev path subcommands flags
  COMPREPLY=()
  cur="\${COMP_WORDS[COMP_CWORD]}"
  prev="\${COMP_WORDS[COMP_CWORD-1]}"

  case "$prev" in
    --model|-m) COMPREPLY=( $(compgen -W "$(_texra_models)" -- "$cur") ); return ;;
    --agent) COMPREPLY=( $(compgen -W "$(_texra_tool_use_agents)" -- "$cur") ); return ;;
    --output-format) COMPREPLY=( $(compgen -W 'text json ndjson' -- "$cur") ); return ;;
    --approval-policy) COMPREPLY=( $(compgen -W 'never ask yolo' -- "$cur") ); return ;;
    --category) COMPREPLY=( $(compgen -W 'workflow toolUse tool-use tool_use' -- "$cur") ); return ;;
    --input|-i|--context|-c|--output|--instruction-file) _texra_compgen_files "$cur"; return ;;
    --cwd|--source|-s|--output-dir|--assets-dir) _texra_compgen_dirs "$cur"; return ;;
    --instruction|--team|--workflow|--tool-use|--default-team|--default-agent|--branch|--base|--limit|-n|--export|--login-hint) COMPREPLY=(); return ;;
  esac

  path="$(_texra_completion_path)"
  case "$path" in
    '') subcommands='orchestrate chat clone run resume setup init config install-github-action history memory agents skills tools multi-agent models login logout auth doctor completion version help'; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --include-interop --source -s' ;;
    orchestrate) subcommands=''; flags='--quiet -q --cwd --approval-policy --color --no-color --include-interop --source -s' ;;
    chat) subcommands=''; flags='--quiet -q --cwd --approval-policy --color --no-color --include-interop --source -s --agent --model -m' ;;
    clone) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    run) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --include-interop --source -s --input -i --context -c --output --output-dir --model -m --instruction --instruction-file' ;;
    resume) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --include-interop --source -s' ;;
    setup) subcommands=''; flags='--quiet -q --cwd --approval-policy --color --no-color' ;;
    init) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --yes -y --force --gitignore' ;;
    config) subcommands='edit show agents'; flags='' ;;
    'config edit') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'config show') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'config agents') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --inherit --all --team --workflow --tool-use --default-team --clear-default --default-agent --clear-default-agent' ;;
    install-github-action) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --branch --base --force --pr --no-pr' ;;
    history) subcommands='list show delete'; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'history list') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --limit -n' ;;
    'history show') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --full --export --assets-dir' ;;
    'history delete') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --all --yes -y' ;;
    memory) subcommands='list show'; flags='' ;;
    'memory list') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'memory show') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    agents) subcommands='list show run'; flags='' ;;
    'agents list') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --all --category' ;;
    'agents show') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'agents run') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --include-interop --source -s --input -i --context -c --model -m --instruction --instruction-file' ;;
    skills) subcommands=list; flags='' ;;
    'skills list') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --include-interop --source -s' ;;
    tools) subcommands='list status enable disable install auth'; flags='' ;;
    'tools list') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'tools status') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'tools enable') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'tools disable') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'tools install') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --run' ;;
    'tools auth') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    multi-agent) subcommands='list show run'; flags='' ;;
    'multi-agent list') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'multi-agent show') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'multi-agent run') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --include-interop --source -s --input -i --context -c --agent --model -m --instruction --instruction-file' ;;
    models) subcommands='list show enabled enable disable'; flags='' ;;
    'models list') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --all' ;;
    'models show') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'models enabled') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'models enable') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'models disable') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    login) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --no-browser --device --select-account --login-hint' ;;
    logout) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    auth) subcommands='login logout status chatgpt grok'; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'auth login') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --no-browser --device --select-account --login-hint' ;;
    'auth logout') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'auth status') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'auth chatgpt') subcommands='login logout status'; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'auth chatgpt login') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --device --no-browser' ;;
    'auth chatgpt logout') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'auth chatgpt status') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'auth grok') subcommands='login logout status'; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'auth grok login') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input --device --no-browser' ;;
    'auth grok logout') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    'auth grok status') subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    doctor) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    completion) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    version) subcommands=''; flags='--print -p --quiet -q --cwd --output-format --approval-policy --color --no-color --no-input' ;;
    help) subcommands=''; flags='' ;;
    *) subcommands='orchestrate chat clone run resume setup init config install-github-action history memory agents skills tools multi-agent models login logout auth doctor completion version help'; flags='' ;;
  esac

  if [[ "$path" == 'run' && "$cur" != -* ]]; then
    COMPREPLY=( $(compgen -W "$(_texra_workflow_agents)" -- "$cur") )
    return
  fi

  if [[ "$path" == 'agents run' && "$cur" != -* ]]; then
    COMPREPLY=( $(compgen -W "$(_texra_tool_use_agents)" -- "$cur") )
    return
  fi

  if [[ "$path" == 'completion' && "$cur" != -* ]]; then
    COMPREPLY=( $(compgen -W 'bash zsh fish' -- "$cur") )
    return
  fi

  if [[ "$path" == 'agents show' && "$cur" != -* ]]; then
    COMPREPLY=( $(compgen -W "$(_texra_agents)" -- "$cur") )
    return
  fi

  if [[ "$path" == 'models show' && "$cur" != -* ]]; then
    COMPREPLY=( $(compgen -W "$(_texra_models)" -- "$cur") )
    return
  fi

  if [[ "$cur" == -* ]]; then
    COMPREPLY=( $(compgen -W "$flags" -- "$cur") )
  else
    COMPREPLY=( $(compgen -W "$subcommands $flags" -- "$cur") )
  fi
}

complete -F _texra texra
"
`;

exports[`CLI shell completion > generates fish completion 1`] = `
"# fish completion for texra
complete -c texra -n '__fish_use_subcommand' -a 'orchestrate' -d 'Interactive launcher (runs by default on bare \`texra\` in a TTY): pick a chat, resume, or team preset'
complete -c texra -n '__fish_use_subcommand' -a 'chat' -d 'Interactive tool-use chat session'
complete -c texra -n '__fish_use_subcommand' -a 'clone' -d 'Clone an Overleaf or ShareLaTeX project into a destination directory'
complete -c texra -n '__fish_use_subcommand' -a 'run' -d 'Run a workflow agent'
complete -c texra -n '__fish_use_subcommand' -a 'resume' -d 'Continue (resume) a stored tool-use or workflow session'
complete -c texra -n '__fish_use_subcommand' -a 'setup' -d 'Guided setup with the setup agent: environment, agent roster, and your first task (sign-in, ChatGPT, or API key first)'
complete -c texra -n '__fish_use_subcommand' -a 'init' -d 'Bootstrap a .texra/config.json with sensible defaults'
complete -c texra -n '__fish_use_subcommand' -a 'config' -d 'Inspect and change TeXRA configuration'
complete -c texra -n '__fish_use_subcommand' -a 'install-github-action' -d 'Install the TeXRA GitHub App and scaffold code review'
complete -c texra -n '__fish_use_subcommand' -a 'history' -d 'Inspect stored executions'
complete -c texra -n '__fish_use_subcommand' -a 'memory' -d 'Inspect stored memories'
complete -c texra -n '__fish_use_subcommand' -a 'agents' -d 'Inspect TeXRA agents'
complete -c texra -n '__fish_use_subcommand' -a 'skills' -d 'Inspect TeXRA skills'
complete -c texra -n '__fish_use_subcommand' -a 'tools' -d 'Inspect external tool integrations'
complete -c texra -n '__fish_use_subcommand' -a 'multi-agent' -d 'List, show, and run multi-agent team presets'
complete -c texra -n '__fish_use_subcommand' -a 'models' -d 'Inspect and manage TeXRA models'
complete -c texra -n '__fish_use_subcommand' -a 'login' -d 'Sign in with Researcher Access'
complete -c texra -n '__fish_use_subcommand' -a 'logout' -d 'Sign out of TeXRA'
complete -c texra -n '__fish_use_subcommand' -a 'auth' -d 'Sign in with ChatGPT, Grok, or your TeXRA account; check status'
complete -c texra -n '__fish_use_subcommand' -a 'doctor' -d 'Check CLI runtime dependencies'
complete -c texra -n '__fish_use_subcommand' -a 'completion' -d 'Print shell completion script'
complete -c texra -n '__fish_use_subcommand' -a 'version' -d 'Print the CLI version'
complete -c texra -n '__fish_use_subcommand' -a 'help' -d 'Show TeXRA CLI commands'
complete -c texra -n '__fish_use_subcommand' -l 'print' -s 'p' -d 'For headless commands, run non-interactively and print the result to stdout'
complete -c texra -n '__fish_use_subcommand' -l 'quiet' -s 'q' -d 'Suppress progress output and informational logs'
complete -c texra -n '__fish_use_subcommand' -l 'cwd' -r -d 'Working directory the agent runs against (defaults to $PWD)'
complete -c texra -n '__fish_use_subcommand' -l 'output-format' -r -a 'text json ndjson' -d 'Output format for headless commands (default: text)'
complete -c texra -n '__fish_use_subcommand' -l 'approval-policy' -r -a 'never ask yolo' -d 'Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)'
complete -c texra -n '__fish_use_subcommand' -l 'color' -d 'Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)'
complete -c texra -n '__fish_use_subcommand' -l 'no-color' -d 'Disable ANSI color on every stream'
complete -c texra -n '__fish_use_subcommand' -l 'no-input' -d 'For headless commands, disable prompts and default approvals to never'
complete -c texra -n '__fish_use_subcommand' -l 'include-interop' -d 'Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory'
complete -c texra -n '__fish_use_subcommand' -l 'source' -s 's' -r -d 'Additional skill root; may be repeated and is resolved relative to --cwd'
complete -c texra -n '__fish_seen_subcommand_from orchestrate' -l 'quiet' -s 'q' -d 'Suppress progress output and informational logs'
complete -c texra -n '__fish_seen_subcommand_from orchestrate' -l 'cwd' -r -d 'Working directory the agent runs against (defaults to $PWD)'
complete -c texra -n '__fish_seen_subcommand_from orchestrate' -l 'approval-policy' -r -a 'never ask yolo' -d 'Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)'
complete -c texra -n '__fish_seen_subcommand_from orchestrate' -l 'color' -d 'Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)'
complete -c texra -n '__fish_seen_subcommand_from orchestrate' -l 'no-color' -d 'Disable ANSI color on every stream'
complete -c texra -n '__fish_seen_subcommand_from orchestrate' -l 'include-interop' -d 'Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory'
complete -c texra -n '__fish_seen_subcommand_from orchestrate' -l 'source' -s 's' -r -d 'Additional skill root; may be repeated and is resolved relative to --cwd'
