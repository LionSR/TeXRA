complete -c texra -n '__fish_seen_subcommand_from run' -l 'include-interop' -d 'Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory'
complete -c texra -n '__fish_seen_subcommand_from run' -l 'source' -s 's' -r -d 'Additional skill root; may be repeated and is resolved relative to --cwd'
complete -c texra -n '__fish_seen_subcommand_from run' -l 'input' -s 'i' -r -d 'Input file passed to the workflow agent (repeatable; use \`-\` to read stdin)'
complete -c texra -n '__fish_seen_subcommand_from run' -l 'context' -s 'c' -r -d 'Read-only context file passed to the workflow agent (repeatable; use \`-\` to read stdin)'
complete -c texra -n '__fish_seen_subcommand_from run' -l 'output' -r -d 'Output file for a single-input run (use --output-dir for multi-input)'
complete -c texra -n '__fish_seen_subcommand_from run' -l 'output-dir' -r -d 'Directory to copy outputs into for multi-input runs'
complete -c texra -n '__fish_seen_subcommand_from run' -l 'model' -s 'm' -r -d 'Model for the agent'
complete -c texra -n '__fish_seen_subcommand_from run' -l 'instruction' -r -d 'Instruction passed to the workflow agent'
complete -c texra -n '__fish_seen_subcommand_from run' -l 'instruction-file' -r -d 'File whose contents are passed before --instruction when both are set'
complete -c texra -n '__fish_seen_subcommand_from resume' -l 'print' -s 'p' -d 'For headless commands, run non-interactively and print the result to stdout'
complete -c texra -n '__fish_seen_subcommand_from resume' -l 'quiet' -s 'q' -d 'Suppress progress output and informational logs'
complete -c texra -n '__fish_seen_subcommand_from resume' -l 'cwd' -r -d 'Working directory the agent runs against (defaults to $PWD)'
