exports[`CLI shell completion > generates zsh completion 1`] = `
"#compdef texra

_texra_agents() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra agents list --quiet 2>/dev/null | awk '{print $2}'
}

_texra_models() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra models list --quiet 2>/dev/null | awk '{print $1}'
}

_texra() {
  local path
  path="\${words[2]}"
  [[ -n "\${words[3]}" && "\${words[3]}" != -* ]] && path="$path \${words[3]}"

  case "$path" in
    'orchestrate') true; _arguments '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:value:' '--api-mode[API access mode: included (TeXRA relay) or personal (your own API keys); also accepts relay/byok]:value:' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' ;;
    'chat') true; _arguments '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:value:' '--api-mode[API access mode: included (TeXRA relay) or personal (your own API keys); also accepts relay/byok]:value:' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--agent[Tool-use agent for the session]:value:' '--model[Model for the session]:value:' '-m[Model for the session]:value:' ;;
    'run') true; _arguments '--print[Run non-interactively and print the result to stdout]' '-p[Run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:value:' '--api-mode[API access mode: included (TeXRA relay) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless runs (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-input[Disable all prompts (headless + deny privileged actions)]' '--input[Input file passed to the workflow agent (repeatable)]:value:' '-i[Input file passed to the workflow agent (repeatable)]:value:' '--context[Read-only context file passed to the workflow agent (repeatable)]:value:' '-c[Read-only context file passed to the workflow agent (repeatable)]:value:' '--output[Output file for a single-input run (use --output-dir for multi-input)]:value:' '--output-dir[Directory to copy outputs into for multi-input runs]:value:' '--model[Model for the agent]:value:' '-m[Model for the agent]:value:' '--instruction[Instruction passed to the workflow agent]:value:' '1:agent:($(_texra_agents))' ;;
