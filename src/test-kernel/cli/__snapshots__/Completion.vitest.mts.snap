exports[`CLI shell completion > generates zsh completion 1`] = `
"#compdef texra

_texra_agents() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra agents list --quiet 2>/dev/null | awk '{print $2}'
}

_texra_workflow_agents() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra agents list --quiet --all --category workflow 2>/dev/null | awk '{print $2}'
}

_texra_tool_use_agents() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra agents list --quiet --all --category toolUse 2>/dev/null | awk '{print $2}'
}

_texra_models() {
  [[ "\${TEXRA_COMPLETION_DYNAMIC:-1}" == "0" ]] && return
  texra models list --quiet 2>/dev/null | awk '{print $1}'
}

_texra() {
  local path
  path="\${words[2]}"
  [[ -n "\${words[3]}" && "\${words[3]}" != -* ]] && path="$path \${words[3]}"

  case "$path" in
    orchestrate) true; _arguments '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--api-mode[Model access: included (your TeXRA account) or personal (your own API keys); also accepts relay/byok]:value:' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--websocket[Use the experimental OpenAI WebSocket transport for this run (overrides the stored setting)]' '--no-websocket[Force the HTTP transport for this run]' '--include-interop[Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory]' '--source[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '-s[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' ;;
    chat) true; _arguments '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--api-mode[Model access: included (your TeXRA account) or personal (your own API keys); also accepts relay/byok]:value:' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--websocket[Use the experimental OpenAI WebSocket transport for this run (overrides the stored setting)]' '--no-websocket[Force the HTTP transport for this run]' '--include-interop[Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory]' '--source[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '-s[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '--agent[Tool-use agent for the session]:agent:($(_texra_tool_use_agents))' '--model[Model for the session]:model:($(_texra_models))' '-m[Model for the session]:model:($(_texra_models))' ;;
    clone) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Empty directory to clone into (defaults to the current directory)]:directory:' '--api-mode[Model access: included (your TeXRA account) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--websocket[Use the experimental OpenAI WebSocket transport for this run (overrides the stored setting)]' '--no-websocket[Force the HTTP transport for this run]' ;;
    run) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--api-mode[Model access: included (your TeXRA account) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--websocket[Use the experimental OpenAI WebSocket transport for this run (overrides the stored setting)]' '--no-websocket[Force the HTTP transport for this run]' '--include-interop[Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory]' '--source[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '-s[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '--input[Input file passed to the workflow agent (repeatable; use \`-\` to read stdin)]:file:' '-i[Input file passed to the workflow agent (repeatable; use \`-\` to read stdin)]:file:' '--context[Read-only context file passed to the workflow agent (repeatable; use \`-\` to read stdin)]:file:' '-c[Read-only context file passed to the workflow agent (repeatable; use \`-\` to read stdin)]:file:' '--output[Output file for a single-input run (use --output-dir for multi-input)]:file:' '--output-dir[Directory to copy outputs into for multi-input runs]:directory:' '--model[Model for the agent]:model:($(_texra_models))' '-m[Model for the agent]:model:($(_texra_models))' '--instruction[Instruction passed to the workflow agent]:value:' '--instruction-file[File whose contents are passed before --instruction when both are set]:file:' 1\\:agent:\\(\\$\\(_texra_workflow_agents\\)\\) ;;
