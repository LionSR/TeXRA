complete -c texra -n '__fish_seen_subcommand_from models; and __fish_seen_subcommand_from show' -a '(test "$TEXRA_COMPLETION_DYNAMIC" != 0; and texra models list --quiet 2>/dev/null | awk "{print \\$1}")'
