    'auth usage') true; _arguments '--print[Run non-interactively and print the result to stdout]' '-p[Run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:value:' '--api-mode[API access mode: included (TeXRA relay) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless runs (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-input[Disable all prompts (headless + deny privileged actions)]' '--month[UTC month to show, formatted as YYYY-MM]:value:' ;;
    'doctor') true; _arguments '--print[Run non-interactively and print the result to stdout]' '-p[Run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:value:' '--api-mode[API access mode: included (TeXRA relay) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless runs (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-input[Disable all prompts (headless + deny privileged actions)]' ;;
    'completion') true; _arguments '--print[Run non-interactively and print the result to stdout]' '-p[Run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:value:' '--api-mode[API access mode: included (TeXRA relay) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless runs (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-input[Disable all prompts (headless + deny privileged actions)]' '1:shell:(bash zsh fish)' ;;
    'version') true; true ;;
    'help') true; true ;;
    *) _arguments '--print[Run non-interactively and print the result to stdout]' '-p[Run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:value:' '--api-mode[API access mode: included (TeXRA relay) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless runs (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-input[Disable all prompts (headless + deny privileged actions)]' '1:command:(orchestrate chat run resume init history memory agents skills tools multi-agent models login logout auth doctor completion version help)' ;;
  esac
}

_texra "$@"
"
`;
