    setup-token) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--api-mode[Model access: included (your TeXRA account) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--websocket[Use the experimental OpenAI WebSocket transport for this run (overrides the stored setting)]' '--no-websocket[Force the HTTP transport for this run]' '--name[Label for the token, shown in \`texra auth token list\`]:value:' '--expires[Days until the token expires (1-365, default 30)]:value:' '--print-env[Print only TEXRA_RELAY_TOKEN=<token> on stdout (e.g. for $GITHUB_ENV)]' ;;
    doctor) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--api-mode[Model access: included (your TeXRA account) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--websocket[Use the experimental OpenAI WebSocket transport for this run (overrides the stored setting)]' '--no-websocket[Force the HTTP transport for this run]' ;;
    completion) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--api-mode[Model access: included (your TeXRA account) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--websocket[Use the experimental OpenAI WebSocket transport for this run (overrides the stored setting)]' '--no-websocket[Force the HTTP transport for this run]' '1:shell:(bash zsh fish)' ;;
    version) true; _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--api-mode[Model access: included (your TeXRA account) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--websocket[Use the experimental OpenAI WebSocket transport for this run (overrides the stored setting)]' '--no-websocket[Force the HTTP transport for this run]' ;;
    help) true; true ;;
    *) _arguments '--print[For headless commands, run non-interactively and print the result to stdout]' '-p[For headless commands, run non-interactively and print the result to stdout]' '--quiet[Suppress progress output and informational logs]' '-q[Suppress progress output and informational logs]' '--cwd[Working directory the agent runs against (defaults to $PWD)]:directory:' '--api-mode[Model access: included (your TeXRA account) or personal (your own API keys); also accepts relay/byok]:value:' '--output-format[Output format for headless commands (default: text)]: :(text json ndjson)' '--approval-policy[Privileged tool actions: never (deny all), ask (prompt; default), or yolo (auto-approve)]: :(never ask yolo)' '--color[Emit ANSI color (also honors NO_COLOR / FORCE_COLOR / TERM)]' '--no-color[Disable ANSI color on every stream]' '--no-input[For headless commands, disable prompts and default approvals to never]' '--websocket[Use the experimental OpenAI WebSocket transport for this run (overrides the stored setting)]' '--no-websocket[Force the HTTP transport for this run]' '--include-interop[Also include .agents/skills, .claude/skills, .codex/skills, and .gemini/skills from the workspace and home directory]' '--source[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '-s[Additional skill root; may be repeated and is resolved relative to --cwd]:directory:' '1:command:(orchestrate chat clone run resume setup init config install-github-action history memory agents skills tools multi-agent latexdiff models login logout auth setup-token doctor completion version help)' ;;
  esac
}

